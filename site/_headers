# 公開版ごとのデータは内容が変わらないため長期キャッシュする
/data/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# MapLibre は版付きのフォルダ（/vendor/maplibre-gl-{版}/）なので、中身は変わらない（設計変更記録 #13・#174）
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 地図の画像（/images/）とロゴ・アイコンは、名前に版が入らず中身が変わりうるので、長くは残さない。
# 1時間は確かめ直さずに使う（設計変更記録 #230。これまではページを開くたびに1件ずつ確かめに行っていた）。
# 公開の直後は、最長1時間、前の画像が出ることがある
/images/*
  Cache-Control: public, max-age=3600

/logo.svg
  Cache-Control: public, max-age=3600

/logo-dark.svg
  Cache-Control: public, max-age=3600

/logo-tagline.svg
  Cache-Control: public, max-age=3600

/logo-mark.svg
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/icon-192.png
  Cache-Control: public, max-age=3600

/icon-512.png
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: frame-ancestors 'self'
