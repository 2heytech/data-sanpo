---
// 地域ページ。初期は市区町村のみ生成し、町丁目は内容が整ったものから追加する（設計書 第12章）。
import Base from "../../layouts/Base.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import AreaShape from "../../components/AreaShape.astro";
import NeighborCompare from "../../components/NeighborCompare.astro";
import ProfileIntro from "../../components/ProfileIntro.astro";
import FurusatoLink from "../../components/FurusatoLink.astro";
import PrNotice from "../../components/PrNotice.astro";
import SmallAreaRanking from "../../components/SmallAreaRanking.astro";
import { smallAreaTables } from "../../lib/smallAreaTables";
import StatList from "../../components/StatList.astro";
import CenterPhotos from "../../components/CenterPhotos.astro";
import AreaArticles from "../../components/AreaArticles.astro";
import { publishedArticles } from "../../lib/articles";
import { articlesForArea } from "../../lib/articleLinks";
import { articleMentions } from "../../lib/articleMentions";
import { RELEASE, loadAreas, loadCenterSpots, loadIndicators, loadValues } from "../../lib/data";
import { aramashiOf } from "../../lib/aramashi";
import { formatValue, rankIfVaried } from "../../lib/format";
import { areaDescription, areaSummary, formerWard } from "../../lib/areaSummary";
import { loadAreaProfile } from "../../lib/profiles";
import { breadcrumbList } from "../../lib/structured";
import { municipalityPeriods } from "../../lib/periods";
import { statGroups } from "../../lib/statList";
import { populationChangeIndicator, populationHistory } from "../../lib/populationHistory";
import type { Municipality, ValueRow } from "../../lib/types";

export function getStaticPaths() {
  const areas = loadAreas();
  return areas.municipalities.map((m) => ({ params: { id: m.id }, props: { muni: m } }));
}
const { muni } = Astro.props as { muni: Municipality };
const areas = loadAreas();
const byId = new Map(areas.municipalities.map((m) => [m.id, m]));
const neighbors = muni.neighbors.map((id) => byId.get(id)!).filter(Boolean);

// 値が1つの都道府県だけにある指標（東京都だけの指標など）は、全国の順位は都道府県内と同じなので出さない
const spansPrefectures = (rows: ValueRow[]) =>
  new Set(rows.filter((r) => r.value !== null).map((r) => r.entity_id.slice(5, 7))).size > 1;
const stats = loadIndicators().map((ind) => {
  // 国勢調査の新しい回（2025年）が市区町村の値で出ている指標は、それで値と順位を出す。
  // その市区町村に値がないとき（区を再編した浜松市の旧区など）は既定の時点で出す（設計変更記録 #118）
  const candidates = municipalityPeriods(ind).map((p) => ({
    period: ind.periods.find((x) => x.period === p)!,
    rows: loadValues(ind.id, p, "municipalities")?.rows ?? [],
  }));
  const { period, rows } = candidates.find((c) => c.rows.some((r) => r.entity_id === muni.id && r.value !== null))
    ?? candidates[candidates.length - 1];
  const row = rows.find((r) => r.entity_id === muni.id);
  return {
    // 順位は同じ都道府県の市区町村の中と、全国の市区町村の中で数える（すべて同じ値なら出さない）
    ind, period, row,
    ranks: [rankIfVaried(rows.filter((r) => r.entity_id.startsWith(`muni-${muni.prefecture}`)), muni.id),
      spansPrefectures(rows) ? rankIfVaried(rows, muni.id) : null],
    neighborRows: neighbors.map((n) => rows.find((r) => r.entity_id === n.id)),
  };
});
const pop = stats.find((s) => s.ind.id === "population_total");
// 人口の時点に値がなく、都道府県内の順位に入らない市区町村（2025年の浜松市の旧区など。文章で母数を正しく書くため）
const popRows = pop ? loadValues(pop.ind.id, pop.period.period, "municipalities")?.rows ?? [] : [];
const excludedFromPrefRank = areas.municipalities.filter((m) => m.prefecture === muni.prefecture
  && !popRows.some((r) => r.entity_id === m.id && r.value !== null));
const pref = areas.prefectures.find((p) => p.code === muni.prefecture)?.name ?? "";
const prefPath = pref ? `/prefectures/${muni.prefecture}/` : null;
// 表の数字から作る短い文章（検索エンジンにも、表だけでなくその地域の特徴が分かるようにする。設計変更記録 #113）
const summary = areaSummary(muni.name, pref, stats.map((s) => ({ ind: s.ind, periodLabel: s.period.label, row: s.row,
  ranks: s.ranks as [typeof s.ranks[0], typeof s.ranks[1]] })), excludedFromPrefRank);
// 決まった条件に当てはまるときだけ出す、推測の表現の考察と、特徴を一言で表す題名（設計変更記録 #113・#115）。
// 指標の順位に加えて、駅・空港・港・地価公示・天気の点のデータも見る。都道府県ページの一覧でも同じ一言を出すので、ビルドの間とっておく
const profile = loadAreaProfile(muni.id);
const insights = profile.lines;
const place = [pref, muni.region].filter(Boolean).join("・");
const statCount = stats.filter((s) => s.row?.value != null).length;
// 浜松市の旧区など、今はない区（設計変更記録 #144）
const former = formerWard(muni.id);
// 人口の移り変わり（国勢調査の各回。設計変更記録 #217）。新しい回を上にする
const history = populationHistory(muni.id);
const changeInd = populationChangeIndicator();
// 説明文は人口・5年前からの増減・人口密度の全国順位から始める（#217）。増減と順位は人口と同じ回のものだけ使う
const samePeriod = (id: string) => stats.find((s) => s.ind.id === id && s.period.period === pop?.period.period);
const description = areaDescription({
  name: muni.name, pref, title: profile.title, insights, statCount, note: former?.note,
  population: pop?.row?.value != null ? {
    text: formatValue(pop.row, pop.ind, { inText: true }), label: pop.period.label,
    change: samePeriod("population_change_rate")?.row?.value ?? null,
    densityRank: samePeriod("population_density")?.ranks[1]?.rank ?? null,
  } : null,
  historyFrom: history.length >= 2 ? history[0].year : null,
});
// パンくず（データさんぽ ＞ 市区町村の一覧 ＞ 都道府県 ＞ 市区町村）。都道府県のページから県内の市区町村へたどれるようにする（設計変更記録 #130）
const structured = breadcrumbList(Astro.site, [
  { name: "データさんぽ", path: "/" }, { name: "市区町村の一覧", path: "/areas/" },
  ...(prefPath ? [{ name: pref, path: prefPath }] : []), { name: muni.name },
]);
// 検索結果で同じ名前の市区町村（府中市・伊達市など）を見分けられるよう、題名に都道府県名を入れる
// 「〇〇 人口 推移」でも探されるので、人口の移り変わりの表があれば「人口推移」と書く（#217）
const popWord = history.length >= 2 ? "人口推移" : "人口";
const pageTitle = pref || former
  ? `${muni.name}（${[pref, former?.label].filter(Boolean).join("・")}）の${popWord}・統計データと順位` : `${muni.name}の${popWord}・統計データと順位`;
// 表に出すのは値のある指標だけ（データなしの行は出さない）。ジャンル・カテゴリごとにまとめる
const groups = statGroups(stats);
// 公式サイトなどで確かめた事実の短いまとめ（設計変更記録 #164）。「データで見る〇〇」の中に出す（#166）。開発用の架空データでは地名が実在しないので出さない
const aramashi = RELEASE.is_fixture ? null : aramashiOf(muni.id);
const hasIntro = summary.length > 0 || insights.length > 0 || !!aramashi;
// この市区町村が順位の表に出てくる寄り道（設計変更記録 #234）
const areaArticles = articlesForArea(muni.id, publishedArticles(), await articleMentions());
// 冒頭の目次（設計変更記録 #193・#215）。スマホでは表やとなりのまちとの比べがずっと下にあるので、最初にそこへ移れるようにする
const toc = [
  ...(history.length ? [{ id: "population", label: "人口の移り変わり" }] : []),
  ...(hasIntro ? [{ id: "profile", label: `データで見る${muni.name}` }] : []),
  ...(loadCenterSpots().has(muni.id) ? [{ id: "photos", label: "中心部の昔と今" }] : []),
  ...(areaArticles.length ? [{ id: "articles", label: `登場する寄り道（${areaArticles.length}）` }] : []),
  { id: "stats", label: `主な指標（${statCount}）` },
  ...(neighbors.length ? [{ id: "compare", label: "となりの市区町村と比べる", main: true }] : []),
  ...(smallAreaTables(muni).tables.length ? [{ id: "small-areas", label: "町丁目別ランキング" }] : []),
];
---
<Base title={pageTitle} description={description} prefecture={pref || undefined} structuredData={structured}>
  <nav class="crumbs muted" aria-label="現在地"><a href="/">トップ</a> › <a href="/areas/">市区町村の一覧</a>{prefPath && <> › <a href={prefPath}>{pref}</a></>}</nav>
  <header class="page-head area-head">
    <AreaShape muni={muni} variant="mark" />
    <div>
      <p class="eyebrow">{place}{former && `（${former.label}）`}</p>
      <h1>{muni.name}の人口・統計データ</h1>
    </div>
    <div class="actions">
      <a class="button" href={`/map/?a=${muni.id}`}>地図で{muni.name}を見る</a>
      <a class="button secondary" href={prefPath ?? "/areas/"}>{prefPath ? `${pref}の市区町村` : "市区町村の一覧"}</a>
    </div>
    <PrNotice />
  </header>

  {/* 冒頭の特徴3つ（考察のうち全国で目立つ事実）と目次（設計変更記録 #193） */}
  <section class="sheet area-points" aria-label={profile.points.length ? `${muni.name}の特徴` : "このページの内容"}>
    {profile.points.length > 0 && (
      <>
        <h2>{muni.name}の特徴</h2>
        <ol class="points">
          {profile.points.map((p) => <li><span class="point-theme">{p.theme}</span><span>{p.text}</span></li>)}
        </ol>
      </>
    )}
    <nav aria-label="このページの目次">
      <ul class="page-toc">
        {toc.map((t) => <li><a class:list={{ main: t.main }} href={`#${t.id}`}>{t.label}</a></li>)}
      </ul>
    </nav>
  </section>

  {history.length > 0 && (
    <section class="sheet" id="population">
      <h2>{muni.name}の人口の移り変わり</h2>
      <div class="table-scroll">
        <table class="pop-history">
          <thead><tr><th>調査年</th><th class="num">人口</th><th class="num">5年間の増減</th><th class="num">世帯数</th></tr></thead>
          <tbody>
            {[...history].reverse().map((h) => (
              <tr>
                <td>{h.year}</td>
                <td class="num">{h.population.toLocaleString("ja-JP")}人</td>
                <td class="num">{h.change === null || !changeInd ? "—" : formatValue({ value: h.change, status: "observed" }, changeInd)}</td>
                <td class="num">{h.households === null ? "—" : `${h.households.toLocaleString("ja-JP")}世帯`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small">国勢調査の各回の10月1日現在の値です。5年間の増減は、前の回の国勢調査からの人口の増加率です。
        <a href="/indicators/population_total/">人口の全国ランキング</a>{changeInd && <>・<a href={`/indicators/${changeInd.id}/`}>人口増加率の全国ランキング</a></>}</p>
    </section>
  )}

  {hasIntro && (
    <section class="sheet area-intro" id="profile">
      <AreaShape muni={muni} variant="locator" prefName={pref} />
      <div>
        <ProfileIntro name={muni.name} profile={profile} summary={summary} aramashi={aramashi} />
      </div>
    </section>
  )}

  {/* 中心部の昔と今の航空写真（設計変更記録 #215） */}
  <CenterPhotos muni={muni} id="photos" />

  <AreaArticles id="articles" name={muni.name} lead={`順位の表に${muni.name}が出てくる分析記事です。`} items={areaArticles} />

  <section class="sheet" id="stats">
    <h2>主な指標<span class="count">{statCount}</span></h2>
    <StatList groups={groups} rankLabels={[`${pref}内`, "全国"]} />
  </section>

  {neighbors.length > 0 && (
    <NeighborCompare title="となりの市区町村と比べる" selfName={muni.name} groups={groups}
      neighbors={neighbors.map((n) => ({ name: n.name, href: `/areas/${n.id}/` }))} />
  )}

  <SmallAreaRanking muni={muni} />

  <FurusatoLink muni={muni} pref={pref} />

  <section class="sheet">
    <h2>データについて</h2>
    <p>各指標の意味・計算方法・注意点・出典は、指標名から開く<strong>指標のページ</strong>にまとめています。サイト全体の出典と利用条件は<a href="/sources/">出典と利用条件</a>をご覧ください。</p>
    <p>町丁目ごとの値は<a href={`/map/?a=${muni.id}`}>地図</a>で拡大すると確認できます（{muni.small_area_count.toLocaleString("ja-JP")}地域）。</p>
  </section>
  <ShareButtons title={pageTitle} />
</Base>

<style>
  .area-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .area-head h1 { margin: 0; }
  .area-head .actions { flex-basis: 100%; }
  :global(.sheet[id]) { scroll-margin-top: 100px; }
  .area-points h2 { margin-top: 0; }
  .pop-history td { white-space: nowrap; }
  .pop-history th.num { white-space: normal; }
  .points { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 8px; }
  .points li {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 10px; align-items: baseline;
    padding: 8px 12px; border-radius: 10px; background: var(--panel); line-height: 1.7;
  }
  .point-theme {
    padding: 1px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-ink);
    font-size: 0.78rem; font-weight: 700; white-space: nowrap;
  }
  .page-toc { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 8px; }
  .page-toc a {
    display: inline-block; padding: 4px 12px; border: 1px solid var(--line); border-radius: 999px;
    font-size: 0.9rem; text-decoration: none; background: var(--surface);
  }
  .page-toc a:hover { background: var(--accent-soft); border-color: #b9d0ea; }
  .page-toc a.main { background: var(--accent); border-color: var(--accent); color: #ffffff; font-weight: 700; }
  .page-toc a.main:hover { background: var(--accent-ink); }
  .area-intro:has(> figure) { display: grid; grid-template-columns: minmax(0, 1fr) 180px; gap: 8px 28px; }
  .area-intro > :global(figure) { grid-column: 2; grid-row: 1; align-self: start; }
  .area-intro:has(> figure) > div { grid-column: 1; grid-row: 1; }
  @media (max-width: 640px) {
    .area-intro:has(> figure) { grid-template-columns: 1fr; }
    .area-intro > :global(figure) { grid-column: 1; grid-row: 1; }
    .area-intro > :global(figure) :global(svg) { max-width: 120px; max-height: 120px; }
    .area-intro:has(> figure) > div { grid-row: 2; }
    .points li { display: block; padding: 8px 10px; font-size: 0.95rem; line-height: 1.65; }
    .pop-history th, .pop-history td { padding: 8px 6px; font-size: 0.88rem; }
    .point-theme { margin-right: 6px; }
  }
</style>
