---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import FeedbackLink from "../../components/FeedbackLink.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { readFileSync } from "node:fs";
import { DATA_BASE, loadIndicators } from "../../lib/data";
const { version } = JSON.parse(readFileSync("node_modules/maplibre-gl/package.json", "utf8"));
const maplibreUrl = `/vendor/maplibre-gl@${version}/maplibre-gl.mjs`;
// 指標の選択画面で使う分類のアイコン（地図の処理が複製して使う）。点レイヤーのカテゴリも含める
const categories = [...new Set([...loadIndicators().map((i) => i.category), "交通", "教育", "地価", "子育て", "天気"])];
---
<Base title="地図" preload={maplibreUrl} description="全国の都道府県・市区町村・町丁目の人口や年齢構成などを色分けした地図。地域名で検索し、指標と時点を切り替えて比べられます。" wide>
  <div class="map-app" data-base={DATA_BASE} data-maplibre={maplibreUrl}>
    <aside class="panel panel-conditions" aria-label="表示する条件">
      <div class="search">
        <label for="search-input">地域を検索</label>
        <input id="search-input" type="search" placeholder="例: 新宿区、本町一丁目" autocomplete="off"
               role="combobox" aria-expanded="false" aria-controls="search-results" />
        <ul id="search-results" role="listbox" hidden></ul>
      </div>
      <div class="field">
        <label for="indicator-open">指標</label>
        <!-- 押すと指標の選択画面を開く。選んだ指標は下の select に入れる（select は状態の保持用） -->
        <button type="button" id="indicator-open" class="indicator-open" aria-haspopup="dialog">
          <span class="io-icon" aria-hidden="true"></span><span class="io-name"></span><span class="io-change">変更</span>
        </button>
        <select id="indicator-select" hidden aria-hidden="true" tabindex="-1"></select>
      </div>
      <!-- 選んだ指標で見られる単位（都道府県・市区町村・町丁目）と対象の都道府県 -->
      <div id="indicator-scope" class="scope small" aria-live="polite"></div>
      <!-- 犯罪など、種別と基準（件数・人口当たり）を切り替える指標 -->
      <div id="facets" class="field facets" hidden>
        <label class="inline">種別 <select id="facet-type"></select></label>
        <label id="facet-basis-wrap" class="inline">基準 <select id="facet-basis"></select></label>
      </div>
      <div class="field period">
        <div class="period-head">
          <label for="period-range">時点</label>
          <output id="period-label" for="period-range"></output>
        </div>
        <div class="period-control">
          <button type="button" id="period-play" class="play-button" aria-pressed="false" aria-label="時点を順に再生">▶</button>
          <input id="period-range" type="range" min="0" max="0" step="1" value="0" />
        </div>
        <div id="period-ticks" class="period-ticks" aria-hidden="true"></div>
        <p id="period-note" class="muted small" hidden></p>
        <label id="aggregate-wrap" class="inline check" hidden><input type="checkbox" id="aggregate-toggle" />
          <span id="aggregate-label">直近5年の合計で見る</span></label>
      </div>
      <div id="legend" class="legend" aria-live="polite"></div>
      <fieldset class="field view-options">
        <legend>表示</legend>
        <label class="inline">範囲
          <select id="region-jump">
            <!-- 公開版の都道府県から地図の処理で作る -->
            <option value="mainland">東京都（区部・多摩）</option>
          </select>
        </label>
        <label class="inline check"><input type="checkbox" id="colors-toggle" checked /> 色分けを表示</label>
        <label class="inline check"><input type="checkbox" id="labels-toggle" checked /> 地名を表示</label>
        <label class="inline check"><input type="checkbox" id="values-toggle" checked /> 地名の下に数値を表示</label>
        <label class="inline check"><input type="checkbox" id="stations-toggle" /> 駅を表示（乗降客数）</label>
        <p id="stations-legend" class="muted small" hidden></p>
        <label class="inline check"><input type="checkbox" id="schools-toggle" /> 公立小中学校を表示（児童・生徒数）</label>
        <p id="schools-legend" class="muted small" hidden></p>
        <label class="inline check"><input type="checkbox" id="land-toggle" /> 地価公示を表示（標準地の価格）</label>
        <p id="land-legend" class="muted small" hidden></p>
        <label class="inline check"><input type="checkbox" id="landsurvey-toggle" /> 都道府県地価調査を表示（基準地の価格）</label>
        <p id="landsurvey-legend" class="muted small" hidden></p>
        <label class="inline check"><input type="checkbox" id="nursery-toggle" /> 認可保育所を表示（定員）</label>
        <p id="nursery-legend" class="muted small" hidden></p>
        <label class="inline check"><input type="checkbox" id="weather-toggle" /> 天気を表示（気象庁の観測所の平年値）</label>
        <select id="weather-select" class="weather-select" aria-label="天気の指標" hidden></select>
        <p id="weather-legend" class="muted small" hidden></p>
        <label class="inline check"><input type="checkbox" id="relief-toggle" /> 標高を色で表示（色別標高図）</label>
        <p id="relief-note" class="muted small" hidden></p>
        <button type="button" id="locate">現在地へ移動</button>
      </fieldset>
    </aside>
    <div class="map-wrap">
      <div id="map" role="region" aria-label="地図"></div>
      <!-- 航空写真（昔の写真も）: 地図の上のボタンで出し、撮影年代のスライドバーも地図の上に置く -->
      <button type="button" id="photo-toggle" class="photo-toggle" aria-pressed="false" aria-controls="photo-panel">航空写真（昔の写真も）</button>
      <section id="photo-panel" class="photo-panel" aria-label="航空写真の撮影年代" hidden>
        <div class="photo-panel-head">
          <output id="photo-era-label" for="photo-era-range" aria-live="polite"></output>
          <button type="button" id="photo-close" class="photo-close" aria-label="航空写真を閉じる" title="航空写真を閉じる">×</button>
        </div>
        <div class="period-control">
          <button type="button" id="photo-era-play" class="play-button" aria-pressed="false" aria-label="撮影年代を順に再生">▶</button>
          <input id="photo-era-range" type="range" min="0" max="0" step="1" value="0" aria-label="撮影年代" />
        </div>
        <div id="photo-era-ends" class="photo-era-ends muted small" aria-hidden="true"></div>
        <p id="photo-note" class="muted small"></p>
      </section>
      <!-- 左右の欄の表示・非表示（地図を広く見る） -->
      <button type="button" class="panel-toggle left" data-panel="left" aria-pressed="false" aria-label="条件の欄を隠す" title="条件の欄を隠す">‹</button>
      <button type="button" class="panel-toggle right" data-panel="right" aria-pressed="false" aria-label="情報の欄を隠す" title="情報の欄を隠す">›</button>
    </div>
    <aside class="panel panel-info" aria-label="地域の情報">
      <section id="pick-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="station-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="school-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="land-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="landsurvey-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="nursery-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="weather-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="detail" class="detail" aria-live="polite">
        <p class="muted">地図をクリックするか、地域名で検索してください。</p>
      </section>
      <details id="list-wrap">
        <summary>一覧で見る</summary>
        <div id="list"></div>
      </details>
      <p class="muted small">
        背景地図: <a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener">地理院タイル</a>。
        <a href="/sources/">統計の出典</a>・<a href="/about/#terms">利用規約</a>・<FeedbackLink />
      </p>
      <AdSlot name="map" />
    </aside>
    <!-- 指標の選択画面（地図の上に重ねて開く。スマホでは全画面） -->
    <dialog id="indicator-picker" class="picker" aria-labelledby="picker-title">
      <div class="picker-head">
        <h2 id="picker-title">指標をえらぶ</h2>
        <input id="picker-search" type="search" placeholder="指標名で探す（例: 人口、犯罪）" autocomplete="off" aria-label="指標名で探す" />
        <button type="button" class="picker-close" aria-label="閉じる">×</button>
      </div>
      <div class="picker-body">
        <nav class="picker-nav" aria-label="分類"></nav>
        <div class="picker-list" tabindex="-1" autofocus></div>
      </div>
    </dialog>
    <template id="category-icons">
      {categories.map((c) => <span data-category={c}><CategoryIcon category={c} /></span>)}
    </template>
  </div>
</Base>

<script>
  import { initMapApp } from "../../map/app";
  const root = document.querySelector<HTMLElement>(".map-app")!;
  void initMapApp(root, root.dataset.base!, root.dataset.maplibre!);
</script>

<style is:global>
  /* 左: 条件、中央: 地図、右: 地域の情報 */
  .map-app {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr) 360px;
    height: calc(100dvh - var(--header-h));
  }
  .map-wrap { position: relative; min-height: 300px; }
  /* 左右の欄を隠したときは、その列を0にして地図を広げる */
  .map-app.hide-left { grid-template-columns: 0 minmax(0, 1fr) 360px; }
  .map-app.hide-right { grid-template-columns: 300px minmax(0, 1fr) 0; }
  .map-app.hide-left.hide-right { grid-template-columns: 0 minmax(0, 1fr) 0; }
  .map-app.hide-left .panel-conditions, .map-app.hide-right .panel-info { display: none; }
  /* 欄を隠しても地図が真ん中の列に残るよう、列を固定する */
  .panel-conditions { grid-column: 1; grid-row: 1; }
  .map-wrap { grid-column: 2; grid-row: 1; }
  .panel-info { grid-column: 3; grid-row: 1; }
  .panel-toggle {
    position: absolute; top: 50%; z-index: 3; transform: translateY(-50%);
    width: 22px; height: 56px; padding: 0; border: 1px solid var(--line); background: rgba(255,255,255,.95);
    font-size: 1.1rem; line-height: 1; color: var(--fg); cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.15);
  }
  .panel-toggle.left { left: 0; border-left: 0; border-radius: 0 6px 6px 0; }
  .panel-toggle.right { right: 0; border-right: 0; border-radius: 6px 0 0 6px; }
  .panel-toggle:hover { background: var(--panel); }
  .pick-list { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .pick-list button {
    width: 100%; text-align: left; font: inherit; padding: 6px 10px; cursor: pointer;
    border: 1px solid var(--line); border-radius: 6px; background: var(--surface);
  }
  .pick-list button:hover { background: var(--panel); }
  #map { position: absolute; inset: 0; }
  .panel { overflow-y: auto; padding: 14px 16px; background: var(--surface); min-width: 0; }
  .panel-conditions { border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; background: #fbfcfe; }
  .panel-info { border-left: 1px solid var(--line); }
  .panel label, .panel legend { display: block; font-weight: 700; font-size: 0.82rem; color: #3a4757; letter-spacing: .02em; }
  .panel select, .panel input[type="search"] {
    width: 100%; font: inherit; font-size: 0.95rem; padding: 7px 10px; margin-top: 4px;
    border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface); color: var(--fg);
  }
  .panel select:focus, .panel input[type="search"]:focus { border-color: var(--accent); outline: 2px solid rgba(11,92,173,.2); }
  .panel input[type="checkbox"] { accent-color: var(--accent); width: 16px; height: 16px; }
  .legend, .view-options { border-top: 1px solid var(--line); padding-top: 12px; }
  .panel label.inline { display: flex; align-items: center; gap: 8px; font-weight: 400; font-size: 0.9rem; color: var(--fg); letter-spacing: 0; }
  .panel label.inline select { width: auto; flex: 1; margin: 0; }
  .panel label.check { gap: 6px; }
  /* display を指定した要素でも hidden で隠す（種別・基準、5年合計のチェック） */
  .panel [hidden] { display: none !important; }
  .facets { display: flex; flex-direction: column; gap: 6px; }
  /* 指標: 選択画面を開くボタン */
  .indicator-open {
    display: flex; align-items: center; gap: 8px; width: 100%; margin-top: 4px; padding: 7px 10px; text-align: left;
    font: inherit; font-size: 0.95rem; font-weight: 700; color: var(--fg); cursor: pointer;
    border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface);
  }
  .indicator-open:hover { border-color: var(--accent); }
  .io-icon { flex: none; display: inline-flex; color: var(--accent); }
  .io-icon svg, .picker svg.cat { width: 22px; height: 22px; }
  .io-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .io-change { flex: none; font-size: 0.75rem; font-weight: 600; color: var(--accent); }
  /* 指標の選択画面 */
  .picker {
    width: min(960px, calc(100vw - 32px)); height: min(720px, calc(100dvh - 48px)); padding: 0;
    border: 0; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,.25); color: var(--fg); background: var(--surface);
  }
  .picker[open] { display: flex; flex-direction: column; }
  .picker::backdrop { background: rgba(20,30,45,.45); }
  .picker-head { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .picker-head h2 { margin: 0; font-size: 1.05rem; white-space: nowrap; }
  .picker-head input {
    flex: 1; min-width: 0; font: inherit; font-size: 0.95rem; padding: 7px 10px;
    border: 1px solid var(--line-strong); border-radius: 8px;
  }
  .picker-close { flex: none; width: 36px; height: 36px; border: 0; background: none; font-size: 1.4rem; cursor: pointer; color: var(--muted); }
  .picker-body { flex: 1; min-height: 0; display: grid; grid-template-columns: 180px minmax(0, 1fr); }
  .picker-nav { overflow-y: auto; padding: 10px 8px; border-right: 1px solid var(--line); background: #fbfcfe; display: grid; align-content: start; gap: 2px; }
  .picker-nav button {
    display: flex; align-items: center; gap: 8px; padding: 7px 8px; border: 0; border-radius: 8px; background: none;
    font: inherit; font-size: 0.9rem; text-align: left; cursor: pointer; color: var(--fg);
  }
  .picker-nav button:hover, .picker-nav button[aria-current="true"] { background: var(--accent-soft, #e6effa); color: var(--accent); }
  .picker-nav svg { width: 18px; height: 18px; flex: none; color: var(--accent); }
  .picker-list { overflow-y: auto; padding: 6px 18px 24px; scroll-padding-top: 8px; outline: none; }
  .picker-genre > h3 { margin: 18px 0 4px; font-size: 0.8rem; color: var(--muted); letter-spacing: .05em; }
  .picker-cat { margin: 6px 0 14px; }
  .picker-cat h4 { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-size: 0.95rem; color: var(--accent); }
  .picker-cat h4 svg { width: 22px; height: 22px; }
  .picker-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 6px; }
  .picker-item {
    display: grid; gap: 2px; padding: 8px 10px; text-align: left; font: inherit; cursor: pointer; color: var(--fg);
    border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
  }
  .picker-item:hover { border-color: var(--accent); background: #f6f9fd; }
  .picker-item[aria-current="true"] { border-color: var(--accent); background: var(--accent-soft, #e6effa); box-shadow: inset 3px 0 0 var(--accent); }
  .pi-name { font-weight: 600; font-size: 0.92rem; }
  .pi-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; font-size: 0.72rem; color: var(--muted); }
  .pi-meta > span { white-space: nowrap; display: inline-flex; }
  .pi-meta svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .pi-meta .limited { color: #8a4b00; font-weight: 600; }
  .picker-points { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; font-size: 0.85rem; }
  .picker-points label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .picker-points .muted { font-size: 0.75rem; }
  .picker-empty { margin: 24px 0; color: var(--muted); }
  @media (max-width: 720px) {
    .picker { width: 100vw; height: 100dvh; max-width: none; max-height: none; border-radius: 0; }
    .picker-body { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); }
    .picker-nav { display: flex; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line); padding: 6px 8px; }
    .picker-nav button { white-space: nowrap; flex: none; }
    .picker-head h2 { display: none; }
    .picker-list { padding: 4px 12px 24px; }
    .picker-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  }
  /* 見られる単位と対象地域（1行） */
  .scope { display: flex; align-items: center; gap: 6px; margin: -6px 0 2px; white-space: nowrap; min-width: 0; }
  .scope-levels { display: flex; gap: 6px; list-style: none; padding: 0; margin: 0; flex: none; }
  .scope-levels li { display: inline-flex; align-items: center; gap: 2px; font-size: 0.72rem; line-height: 1.5; }
  .scope-levels svg { fill: none; stroke: currentColor; stroke-width: 1.3; }
  .scope-levels li.on { color: var(--accent, #0b5cad); font-weight: 600; }
  .scope-levels li.on svg { fill: var(--accent-soft, #e6effa); }
  .scope-levels li.later { color: var(--muted); }
  .scope-levels li.later svg { stroke-dasharray: 2 1.5; }
  .scope-area { font-size: 0.72rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; padding-left: 6px; border-left: 1px solid var(--line); }
  .scope-area.limited { color: #8a4b00; font-weight: 600; }
  .facets label.inline { font-weight: 600; }
  .period.aggregate #period-range, .period.aggregate .period-ticks, .period.aggregate #period-play { opacity: 0.4; }
  .view-options { border: 0; border-top: 1px solid var(--line); padding: 12px 0 0; margin: 0; display: grid; gap: 6px; }
  .view-options button {
    justify-self: start; font: inherit; font-size: 0.9rem; padding: 4px 10px;
    border: 1px solid var(--line); border-radius: 6px; background: var(--surface); cursor: pointer;
  }
  .period-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  #period-label { font-weight: 700; font-variant-numeric: tabular-nums; }
  .period-control { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
  .period-control input { flex: 1; accent-color: var(--accent); }
  .play-button {
    flex: none; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line);
    background: var(--surface); cursor: pointer; font-size: 0.8rem;
  }
  .play-button[aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
  .play-button:disabled { opacity: 0.4; cursor: default; }
  .period-ticks { display: flex; justify-content: space-between; margin-left: 40px; font-size: 0.8rem; color: var(--muted); }
  .period-ticks span { cursor: pointer; }
  .photo-toggle {
    position: absolute; top: 10px; left: 32px; z-index: 3; padding: 6px 12px; font: inherit; font-size: 0.9rem;
    border: 1px solid var(--line); border-radius: 6px; background: rgba(255,255,255,.95); color: var(--fg);
    cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.15);
  }
  .photo-toggle[aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
  .photo-panel {
    position: absolute; left: 50%; bottom: 40px; z-index: 3; transform: translateX(-50%);
    width: min(460px, calc(100% - 96px)); padding: 8px 12px 6px; border: 1px solid var(--line); border-radius: 8px;
    background: rgba(255,255,255,.96); box-shadow: 0 2px 8px rgba(0,0,0,.2);
  }
  .photo-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  #photo-era-label { font-size: 1.15rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .photo-close { border: 0; background: none; font-size: 1.3rem; line-height: 1; padding: 2px 6px; cursor: pointer; color: var(--muted); }
  .photo-panel p { margin: 2px 0 0; }
  .photo-panel [hidden] { display: none; }
  .photo-era-ends { display: flex; justify-content: space-between; margin-left: 40px; }
  .period-ticks span[aria-current="true"] { color: var(--fg); font-weight: 700; }
  .search { position: relative; }
  #search-results {
    position: absolute; z-index: 5; left: 0; right: 0; margin: 2px 0 0; padding: 0; list-style: none;
    background: #fff; border: 1px solid var(--line); border-radius: 6px; max-height: 50vh; overflow-y: auto;
    box-shadow: 0 4px 12px rgba(0,0,0,.12);
  }
  #search-results li { padding: 6px 10px; cursor: pointer; }
  #search-results li[aria-selected="true"], #search-results li:hover { background: var(--panel); }
  .legend { font-size: 0.85rem; }
  .legend p { margin: 0; }
  .legend-head { font-weight: 600; }
  .legend-head .muted { font-weight: 400; }
  /* 色の区切りは1本の帯にし、境目の下に値を書く */
  .legend-bar { display: flex; height: 14px; margin-top: 6px; border: 1px solid rgba(0,0,0,.2); border-radius: 3px; overflow: hidden; }
  .legend-bar span { flex: 1; }
