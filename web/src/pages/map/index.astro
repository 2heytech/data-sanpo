---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import FeedbackLink from "../../components/FeedbackLink.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { readFileSync } from "node:fs";
import { DATA_BASE, RELEASE, loadIndicators } from "../../lib/data";
const { version } = JSON.parse(readFileSync("node_modules/maplibre-gl/package.json", "utf8"));
const maplibreUrl = `/vendor/maplibre-gl@${version}/maplibre-gl.mjs`;
// 右の欄の「〇〇の公式サイト」の URL 一覧（pages/official-sites.json.ts）。架空の地名を使う開発用データでは出さない
const officialSitesUrl = RELEASE.is_fixture ? "" : "/official-sites.json";
// 指標の選択画面で使う分類のアイコン（地図の処理が複製して使う）。点レイヤーのカテゴリも含める
// 左の欄の切替アイコン（24×24 の線画）。name は短い名前、title は説明つきの名前（右の欄の見出しにも使う）
const ICON: Record<string, string> = {
  colors: '<rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1" fill="currentColor" fill-opacity=".85"/><rect x="13" y="3.5" width="7.5" height="7.5" rx="1" fill="currentColor" fill-opacity=".45"/><rect x="3.5" y="13" width="7.5" height="7.5" rx="1" fill="currentColor" fill-opacity=".25"/><rect x="13" y="13" width="7.5" height="7.5" rx="1"/>',
  labels: '<path d="M4 6V4.5h16V6M12 4.5v15M8.5 19.5h7"/>',
  values: '<path d="M4.5 8 6.5 6.5V17M4.5 17h4M10.5 8.5a2.2 2.2 0 0 1 4.3.6c0 2.6-4.3 4.6-4.3 7.9h4.6M17 7h3.5l-2 3.3a2.9 2.9 0 1 1-2 4.9"/>',
  stations: '<rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 10h14M8.5 14h.01M15.5 14h.01M8 17l-2.5 4M16 17l2.5 4"/>',
  schools: '<path d="M3 20h18M5 20V10l7-5 7 5v10"/><path d="M10 20v-5h4v5M12 5V2.5h3"/>',
  land: '<circle cx="12" cy="12" r="9"/><path d="M8.5 7 12 12l3.5-5M12 12v5.5M9 12.5h6M9 15h6"/>',
  nursery: '<circle cx="8" cy="5.5" r="2.5"/><path d="M4 21v-7a4 4 0 0 1 8 0v7"/><circle cx="17" cy="10" r="2"/><path d="M14 21v-4a3 3 0 0 1 6 0v4M12 15h2"/>',
  airports: '<path d="M21 15.5v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0v5l-8 5v2l8-2.5v5l-2 1.5V21l3.5-1 3.5 1v-1.5L13 18v-5z"/>',
  ports: '<circle cx="12" cy="5" r="2"/><path d="M12 7v14M7 10h10M4.5 14.5A7.5 7.5 0 0 0 12 21a7.5 7.5 0 0 0 7.5-6.5M3 14.5h3M18 14.5h3"/>',
  weather: '<circle cx="9" cy="9" r="3.5"/><path d="M9 2.5v1.5M2.5 9H4M4.4 4.4l1.1 1.1M13.6 4.4l-1.1 1.1"/><path d="M8 20h10a3.5 3.5 0 0 0 0-7 5 5 0 0 0-9.6 1.5A2.8 2.8 0 0 0 8 20z"/>',
  landuse: '<rect x="3.5" y="3.5" width="17" height="17" rx="1.5"/><path d="M12 3.5v17M3.5 12h17M5.5 9.5l4-4M5.5 7l1.5-1.5M14 20.5l6.5-6.5M16.5 20.5l4-4"/>',
  // 背景の切替（地図の左上）のアイコン: 地図・航空写真・標高
  pale: '<path d="M9 4.5 3.5 6.5v13l5.5-2 6 2 5.5-2v-13l-5.5 2-6-2z"/><path d="M9 4.5v13M15 6.5v13"/>',
  photo: '<rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m3.5 17 5-4.5 3.5 3 3-2.5 5.5 4.5"/>',
  relief: '<path d="M2 20 9 7.5l3.5 5.5 2.5-3.5L22 20z"/><path d="M7.2 10.7 9 12l1.8-1.3"/>',
};
const VIEW_TOGGLES = [
  { id: "colors-toggle", name: "色分け", title: "色分けを表示", icon: ICON.colors },
  { id: "labels-toggle", name: "地名", title: "地名を表示", icon: ICON.labels },
  { id: "values-toggle", name: "数値", title: "地名の下に数値を表示", icon: ICON.values },
];
const OVERLAYS = [
  { id: "stations-toggle", note: "stations-legend", name: "駅", title: "駅（乗降客数）", icon: ICON.stations },
  { id: "airports-toggle", note: "airports-legend", name: "空港", title: "空港（乗降客数）", icon: ICON.airports },
  { id: "ports-toggle", note: "ports-legend", name: "港", title: "港（船の乗降人員）", icon: ICON.ports },
  { id: "schools-toggle", note: "schools-legend", name: "小中学校", title: "公立小中学校（児童・生徒数）", icon: ICON.schools },
  { id: "land-toggle", note: "land-legend", name: "地価", title: "地価（地価公示・都道府県地価調査）", icon: ICON.land },
  { id: "nursery-toggle", note: "nursery-legend", name: "保育所", title: "認可保育所（定員）", icon: ICON.nursery },
  { id: "weather-toggle", note: "weather-legend", name: "天気", title: "天気（気象庁の観測所の平年値）", icon: ICON.weather },
];
// 背景（地図の左上で、どれか1つを選ぶ。#128）。標高・土地利用は左の欄の「地図に重ねる」から移した
const BASES = [
  { id: "pale", name: "地図", title: "地図（淡色地図）", icon: ICON.pale },
  { id: "photo", name: "航空写真", title: "航空写真（昔の写真も）", icon: ICON.photo },
  { id: "relief", name: "標高", title: "標高（色別標高図）", icon: ICON.relief },
  { id: "landuse", name: "土地利用", title: "土地利用（100m四方のマス）", icon: ICON.landuse },
];
// 標高の色の見本（地理院タイル「色別標高図」の平らな所の色を、標高ごとに読み取ったもの）。帯は等間隔で、目盛りは一部だけ書く
const RELIEF_STOPS = [
  { m: 0, color: "#2db5ae", tick: "0m" }, { m: 10, color: "#2db579" }, { m: 50, color: "#52b52d" },
  { m: 100, color: "#71b52d", tick: "100" }, { m: 200, color: "#99b52d" }, { m: 300, color: "#b5a92d", tick: "300" },
  { m: 500, color: "#b5902d" }, { m: 1000, color: "#b5562d", tick: "1000" }, { m: 2000, color: "#b5491b" },
  { m: 3000, color: "#b54212", tick: "3000m" },
];
const reliefGradient = `linear-gradient(to right, ${RELIEF_STOPS.map((s, i) => `${s.color} ${(i / (RELIEF_STOPS.length - 1)) * 100}%`).join(", ")})`;
const categories = [...new Set([...loadIndicators().map((i) => i.category), "交通", "教育", "地価", "子育て", "天気"])];
---
<Base title="地図" preload={maplibreUrl} description="全国の都道府県・市区町村・町丁目の人口や年齢構成などを色分けした地図。地域名で検索し、指標と時点を切り替えて比べられます。" wide>
  <div class="map-app" data-base={DATA_BASE} data-maplibre={maplibreUrl} data-official-sites={officialSitesUrl}>
    <aside class="panel panel-conditions" aria-label="表示する条件">
      <!-- 範囲と地域の検索はあまり使わないので、最初は畳んでおく（開いた状態は覚えない、#103） -->
      <details class="move-tools">
        <summary>範囲・地域を検索</summary>
        <div class="move-tools-body">
          <div class="field region">
            <label for="region-jump">範囲</label>
            <div class="region-row">
              <select id="region-jump">
                <!-- 公開版の都道府県から地図の処理で作る（都道府県コードの順） -->
                <option value="mainland">東京都（区部・多摩）</option>
              </select>
              <button type="button" id="locate" class="locate" aria-label="現在地へ移動" title="現在地へ移動">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="2" fill="currentColor"/><path d="M12 2v3.5M12 18.5V22M2 12h3.5M18.5 12H22"/></svg>
              </button>
            </div>
          </div>
          <div class="search">
            <label for="search-input">地域を検索</label>
            <input id="search-input" type="search" placeholder="例: 新宿区、本町一丁目" autocomplete="off"
                   role="combobox" aria-expanded="false" aria-controls="search-results" />
            <ul id="search-results" role="listbox" hidden></ul>
          </div>
        </div>
      </details>
      <div class="field">
        <label for="indicator-open">指標</label>
        <!-- 押すと指標の選択画面を開く。選んだ指標は下の select に入れる（select は状態の保持用） -->
        <button type="button" id="indicator-open" class="indicator-open" aria-haspopup="dialog">
          <span class="io-icon" aria-hidden="true"></span><span class="io-name"></span><span class="io-change">変更</span>
        </button>
        <select id="indicator-select" hidden aria-hidden="true" tabindex="-1"></select>
      </div>
      <!-- 選んだ指標で見られる単位（都道府県・市区町村・町丁目）と対象の都道府県 -->
      <div id="indicator-scope" class="scope small" aria-live="polite"></div>
      <!-- 犯罪など、種別と基準（件数・人口当たり）を切り替える指標 -->
      <div id="facets" class="field facets" hidden>
        <label id="facet-type-wrap" class="inline">種別 <select id="facet-type"></select></label>
        <label id="facet-basis-wrap" class="inline">基準 <select id="facet-basis"></select></label>
      </div>
      <div class="field period">
        <div class="period-head">
          <label for="period-range">時点</label>
          <output id="period-label" for="period-range"></output>
        </div>
        <div class="period-control">
          <button type="button" id="period-play" class="play-button" aria-pressed="false" aria-label="時点を順に再生">▶</button>
          <input id="period-range" type="range" min="0" max="0" step="1" value="0" />
        </div>
        <div id="period-ticks" class="period-ticks" aria-hidden="true"></div>
        <p id="period-note" class="muted small" hidden></p>
        <label id="aggregate-wrap" class="inline check" hidden><input type="checkbox" id="aggregate-toggle" />
          <span id="aggregate-label">直近5年の合計で見る</span></label>
      </div>
      <div id="legend" class="legend" aria-live="polite"></div>
      <!-- 表示に関する切替（色分け・地名・数値）は1行のアイコン、地図に重ねるものはアイコンの並び。
           細かい説明は右の情報の欄に出す（#97）。チェックボックスは見えないだけで、id と動きはそのまま -->
      <fieldset class="field view-options">
        <legend>表示</legend>
        <div class="icon-toggles three">
          {VIEW_TOGGLES.map((t) => (
            <label class="icon-toggle" title={t.title}>
              <input type="checkbox" id={t.id} checked class="vh" />
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /><span>{t.name}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <fieldset class="field view-options">
        <legend>地図に重ねる</legend>
        <div class="icon-toggles">
          {OVERLAYS.map((t) => (
            <label class="icon-toggle" title={t.title}>
              <input type="checkbox" id={t.id} class="vh" />
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /><span>{t.name}</span>
            </label>
          ))}
        </div>
      </fieldset>
    </aside>
    <div class="map-wrap">
      <div id="map" role="region" aria-label="地図"></div>
      <!-- 背景: 地図・航空写真（昔の写真も）・標高・土地利用のどれか1つを地図の左上で選ぶ。航空写真の撮影年代・土地利用の年度・
           標高の色の見本は、選んだものだけ地図の上のパネルに出す（ふだんは地図の下側、地図の幅が狭いときは切替のすぐ下。#128） -->
      <div class="base-switch" role="group" aria-label="背景">
        {BASES.map((b) => (
          <button type="button" data-basemap={b.id} aria-pressed={b.id === "pale" ? "true" : "false"} title={b.title}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={b.icon} /><span>{b.name}</span>
          </button>
        ))}
      </div>
      <section id="photo-panel" class="base-panel" aria-label="航空写真の撮影年代" hidden>
        <div class="base-panel-head">
          <output id="photo-era-label" for="photo-era-range" aria-live="polite"></output>
          <button type="button" class="base-close" aria-label="航空写真を閉じる" title="航空写真を閉じる">×</button>
        </div>
        <div class="period-control">
          <button type="button" id="photo-era-play" class="play-button" aria-pressed="false" aria-label="撮影年代を順に再生">▶</button>
          <input id="photo-era-range" type="range" min="0" max="0" step="1" value="0" aria-label="撮影年代" />
        </div>
        <div id="photo-era-ends" class="photo-era-ends muted small" aria-hidden="true"></div>
        <p id="photo-note" class="muted small"></p>
      </section>
      <section id="relief-panel" class="base-panel" aria-label="標高の色" hidden>
        <div class="base-panel-head">
          <span class="base-panel-title">標高（色別標高図）</span>
          <button type="button" class="base-close" aria-label="標高を閉じる" title="標高を閉じる">×</button>
        </div>
        <div class="relief-bar" style={`background: ${reliefGradient}`} aria-hidden="true"></div>
        <div class="relief-ticks muted small" aria-hidden="true">
          {RELIEF_STOPS.map((s, i) => s.tick && <span style={`left: ${(i / (RELIEF_STOPS.length - 1)) * 100}%`}>{s.tick}</span>)}
        </div>
        <p id="relief-note" class="muted small" hidden></p>
      </section>
      <section id="landuse-panel" class="base-panel" aria-label="土地利用図の年度" hidden>
        <div class="base-panel-head">
          <output id="landuse-year-label" for="landuse-year" aria-live="polite"></output>
          <span class="base-panel-tools">
            <button type="button" id="landuse-legend-toggle" class="legend-toggle" aria-expanded="true" aria-controls="landuse-legend">凡例</button>
            <button type="button" class="base-close" aria-label="土地利用を閉じる" title="土地利用を閉じる">×</button>
          </span>
        </div>
        <div class="period-control">
          <button type="button" id="landuse-play" class="play-button" aria-pressed="false" aria-label="年度を順に再生">▶</button>
          <input id="landuse-year" type="range" min="0" max="0" step="1" value="0" aria-label="土地利用の年度" />
        </div>
        <div id="landuse-year-ticks" class="period-ticks" aria-hidden="true"></div>
        <div id="landuse-legend" class="land-bins"></div>
        <p id="landuse-note" class="muted small" hidden></p>
      </section>
      <!-- 左右の欄の表示・非表示（地図を広く見る） -->
      <button type="button" class="panel-toggle left" data-panel="left" aria-pressed="false" aria-label="条件の欄を隠す" title="条件の欄を隠す">‹</button>
      <button type="button" class="panel-toggle right" data-panel="right" aria-pressed="false" aria-label="情報の欄を隠す" title="情報の欄を隠す">›</button>
    </div>
    <aside class="panel panel-info" aria-label="地域の情報">
      <!-- 地図に重ねている点・標高の見方（左の欄のアイコンでオンにしたものだけ出す） -->
      <section class="overlay-notes" aria-label="地図に重ねているものの見方">
        {OVERLAYS.map((t) => (
          <div class="overlay-note">
            <h3><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />{t.title}</h3>
            {t.id === "weather-toggle" && <select id="weather-select" class="weather-select" aria-label="天気の指標" hidden></select>}
            <p id={t.note} class="muted small" hidden></p>
          </div>
        ))}
        <!-- 土地利用図の読み方（年度・凡例は地図の上のパネル） -->
        <div class="overlay-note">
          <h3><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.landuse} />土地利用（100m四方のマス）</h3>
          <p id="landuse-info" class="muted small" hidden>100m四方のマスごとに、その中で最も広い土地利用の色で塗っています。年度によって判読の方法が違います。</p>
        </div>
      </section>
      <section id="pick-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="station-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="airport-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="port-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="school-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="land-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="nursery-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="weather-detail" class="detail station-detail" aria-live="polite" hidden></section>
      <section id="detail" class="detail" aria-live="polite">
        <p class="muted">地図をクリックするか、地域名で検索してください。</p>
      </section>
      <p class="muted small panel-foot">
        背景地図: <a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener">地理院タイル</a>。
        <a href="/sources/">統計の出典</a>・<a href="/about/#terms">利用規約</a>・<FeedbackLink />
      </p>
      <AdSlot name="map" />
    </aside>
    <!-- 指標の選択画面（地図の上に重ねて開く。スマホでは全画面） -->
    <dialog id="indicator-picker" class="picker" aria-labelledby="picker-title">
      <div class="picker-head">
        <h2 id="picker-title">指標をえらぶ</h2>
        <input id="picker-search" type="search" placeholder="指標名で探す（例: 人口、犯罪）" autocomplete="off" aria-label="指標名で探す" />
        <button type="button" class="picker-close" aria-label="閉じる">×</button>
      </div>
      <div class="picker-body">
        <nav class="picker-nav" aria-label="分類"></nav>
        <div class="picker-list" tabindex="-1" autofocus></div>
      </div>
    </dialog>
    <template id="category-icons">
      {categories.map((c) => <span data-category={c}><CategoryIcon category={c} /></span>)}
    </template>
  </div>
</Base>

<script>
  import { initMapApp } from "../../map/app";
  const root = document.querySelector<HTMLElement>(".map-app")!;
  void initMapApp(root, root.dataset.base!, root.dataset.maplibre!);
</script>

<style is:global>
  /* 左: 条件、中央: 地図、右: 地域の情報 */
  .map-app {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr) 360px;
    height: calc(100dvh - var(--header-h));
  }
  /* 地図の幅で背景の切替・パネルの置き方を変える（下の @container） */
  .map-wrap { position: relative; min-height: 300px; container-type: inline-size; }
  /* 左右の欄を隠したときは、その列を0にして地図を広げる */
  .map-app.hide-left { grid-template-columns: 0 minmax(0, 1fr) 360px; }
  .map-app.hide-right { grid-template-columns: 300px minmax(0, 1fr) 0; }
  .map-app.hide-left.hide-right { grid-template-columns: 0 minmax(0, 1fr) 0; }
  .map-app.hide-left .panel-conditions, .map-app.hide-right .panel-info { display: none; }
  /* 欄を隠しても地図が真ん中の列に残るよう、列を固定する */
  .panel-conditions { grid-column: 1; grid-row: 1; }
  .map-wrap { grid-column: 2; grid-row: 1; }
  .panel-info { grid-column: 3; grid-row: 1; }
  .panel-toggle {
    position: absolute; top: 50%; z-index: 3; transform: translateY(-50%);
    width: 22px; height: 56px; padding: 0; border: 1px solid var(--line); background: rgba(255,255,255,.95);
    font-size: 1.1rem; line-height: 1; color: var(--fg); cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.15);
  }
  .panel-toggle.left { left: 0; border-left: 0; border-radius: 0 6px 6px 0; }
  .panel-toggle.right { right: 0; border-right: 0; border-radius: 6px 0 0 6px; }
  .panel-toggle:hover { background: var(--panel); }
  .pick-list { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .pick-list button {
    width: 100%; text-align: left; font: inherit; padding: 6px 10px; cursor: pointer;
    border: 1px solid var(--line); border-radius: 6px; background: var(--surface);
  }
  .pick-list button:hover { background: var(--panel); }
  #map { position: absolute; inset: 0; }
  .panel { overflow-y: auto; padding: 14px 16px; background: var(--surface); min-width: 0; }
  .panel-conditions { border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; background: #fbfcfe; }
  .panel-info { border-left: 1px solid var(--line); }
  .panel label, .panel legend { display: block; font-weight: 700; font-size: 0.82rem; color: #3a4757; letter-spacing: .02em; }
  .panel select, .panel input[type="search"] {
    width: 100%; font: inherit; font-size: 0.95rem; padding: 7px 10px; margin-top: 4px;
    border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface); color: var(--fg);
  }
  .panel select:focus, .panel input[type="search"]:focus { border-color: var(--accent); outline: 2px solid rgba(11,92,173,.2); }
  .panel input[type="checkbox"] { accent-color: var(--accent); width: 16px; height: 16px; }
  .legend, .view-options { border-top: 1px solid var(--line); padding-top: 12px; }
  .panel label.inline { display: flex; align-items: center; gap: 8px; font-weight: 400; font-size: 0.9rem; color: var(--fg); letter-spacing: 0; }
  .panel label.inline select { width: auto; flex: 1; margin: 0; }
  .panel label.check { gap: 6px; }
  /* display を指定した要素でも hidden で隠す（種別・基準、5年合計のチェック） */
  .panel [hidden] { display: none !important; }
  .facets { display: flex; flex-direction: column; gap: 6px; }
  /* 指標: 選択画面を開くボタン */
  .indicator-open {
    display: flex; align-items: center; gap: 8px; width: 100%; margin-top: 4px; padding: 7px 10px; text-align: left;
    font: inherit; font-size: 0.95rem; font-weight: 700; color: var(--fg); cursor: pointer;
    border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface);
  }
  .indicator-open:hover { border-color: var(--accent); }
  .io-icon { flex: none; display: inline-flex; color: var(--accent); }
  .io-icon svg, .picker svg.cat { width: 22px; height: 22px; }
  .io-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .io-change { flex: none; font-size: 0.75rem; font-weight: 600; color: var(--accent); }
  /* 指標の選択画面 */
  .picker {
    width: min(960px, calc(100vw - 32px)); height: min(720px, calc(100dvh - 48px)); padding: 0;
    border: 0; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,.25); color: var(--fg); background: var(--surface);
  }
  .picker[open] { display: flex; flex-direction: column; }
  .picker::backdrop { background: rgba(20,30,45,.45); }
  .picker-head { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .picker-head h2 { margin: 0; font-size: 1.05rem; white-space: nowrap; }
  .picker-head input {
    flex: 1; min-width: 0; font: inherit; font-size: 0.95rem; padding: 7px 10px;
    border: 1px solid var(--line-strong); border-radius: 8px;
  }
  .picker-close { flex: none; width: 36px; height: 36px; border: 0; background: none; font-size: 1.4rem; cursor: pointer; color: var(--muted); }
  .picker-body { flex: 1; min-height: 0; display: grid; grid-template-columns: 180px minmax(0, 1fr); }
  .picker-nav { overflow-y: auto; padding: 10px 8px; border-right: 1px solid var(--line); background: #fbfcfe; display: grid; align-content: start; gap: 2px; }
  .picker-nav button {
    display: flex; align-items: center; gap: 8px; padding: 7px 8px; border: 0; border-radius: 8px; background: none;
    font: inherit; font-size: 0.9rem; text-align: left; cursor: pointer; color: var(--fg);
  }
  .picker-nav button:hover, .picker-nav button[aria-current="true"] { background: var(--accent-soft, #e6effa); color: var(--accent); }
  .picker-nav svg { width: 18px; height: 18px; flex: none; color: var(--accent); }
  .picker-list { overflow-y: auto; padding: 6px 18px 24px; scroll-padding-top: 8px; outline: none; }
  .picker-genre > h3 { margin: 18px 0 4px; font-size: 0.8rem; color: var(--muted); letter-spacing: .05em; }
  .picker-cat { margin: 6px 0 14px; }
  .picker-cat h4 { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-size: 0.95rem; color: var(--accent); }
  .picker-cat h4 svg { width: 22px; height: 22px; }
  .picker-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 6px; }
  .picker-item {
    display: grid; gap: 2px; padding: 8px 10px; text-align: left; font: inherit; cursor: pointer; color: var(--fg);
    border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
  }
  /* 名前で探したときに当てはまらない指標を隠す（display: grid が hidden より強いので明示する） */
  .picker-item[hidden] { display: none; }
  .picker-item:hover { border-color: var(--accent); background: #f6f9fd; }
  .picker-item[aria-current="true"] { border-color: var(--accent); background: var(--accent-soft, #e6effa); box-shadow: inset 3px 0 0 var(--accent); }
  .pi-name { font-weight: 600; font-size: 0.92rem; }
  .pi-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; font-size: 0.72rem; color: var(--muted); }
  .pi-meta > span { white-space: nowrap; display: inline-flex; }
  .pi-meta svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .pi-meta .limited { color: #8a4b00; font-weight: 600; }
  .picker-points { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; font-size: 0.85rem; }
  .picker-points label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .picker-points .muted { font-size: 0.75rem; }
  .picker-empty { margin: 24px 0; color: var(--muted); }
  @media (max-width: 720px) {
    .picker { width: 100vw; height: 100dvh; max-width: none; max-height: none; border-radius: 0; }
    .picker-body { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); }
    .picker-nav { display: flex; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line); padding: 6px 8px; }
    .picker-nav button { white-space: nowrap; flex: none; }
    .picker-head h2 { display: none; }
    .picker-list { padding: 4px 12px 24px; }
    .picker-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  }
  /* 見られる単位と対象地域（1行） */
  .scope { display: flex; align-items: center; gap: 6px; margin: -6px 0 2px; white-space: nowrap; min-width: 0; }
  .scope-levels { display: flex; gap: 6px; list-style: none; padding: 0; margin: 0; flex: none; }
  .scope-levels li { display: inline-flex; align-items: center; gap: 2px; font-size: 0.72rem; line-height: 1.5; }
  .scope-levels svg { fill: none; stroke: currentColor; stroke-width: 1.3; }
  .scope-levels li.on { color: var(--accent, #0b5cad); font-weight: 600; }
  .scope-levels li.on svg { fill: var(--accent-soft, #e6effa); }
  .scope-levels li.later { color: var(--muted); }
  .scope-levels li.later svg { stroke-dasharray: 2 1.5; }
  .scope-area { font-size: 0.72rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; padding-left: 6px; border-left: 1px solid var(--line); }
  .scope-area.limited { color: #8a4b00; font-weight: 600; }
  .facets label.inline { font-weight: 600; }
  .period.aggregate #period-range, .period.aggregate .period-ticks, .period.aggregate #period-play { opacity: 0.4; }
  .view-options { border: 0; border-top: 1px solid var(--line); padding: 12px 0 0; margin: 0; display: grid; gap: 6px; }
  /* 範囲と現在地ボタン */
  /* 範囲・地域を検索（畳める） */
  .move-tools summary {
    display: flex; align-items: center; gap: 6px; cursor: pointer; list-style: none;
    font-weight: 700; font-size: 0.82rem; color: #3a4757; letter-spacing: .02em;
  }
  .move-tools summary::-webkit-details-marker { display: none; }
  .move-tools summary::before {
    content: ""; width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(-45deg); transition: transform .15s; margin: 0 2px;
  }
  .move-tools[open] summary::before { transform: rotate(45deg); }
  .move-tools-body { display: flex; flex-direction: column; gap: 14px; margin-top: 10px; }
  .region-row { display: flex; gap: 6px; align-items: stretch; }
  .region-row select { flex: 1; min-width: 0; }
  .locate {
    flex: none; width: 38px; margin-top: 4px; padding: 0; display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface); color: var(--accent);
  }
  .locate:hover { background: var(--panel); }
  .locate svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  /* アイコンの切替（押すと青くなる）。チェックボックスは見えなくして、ラベル全体を押せるようにする */
  .vh { position: absolute !important; width: 1px !important; height: 1px !important; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); border: 0; opacity: 0; }
  .icon-toggles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin-top: 2px; }
  .icon-toggles.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .panel label.icon-toggle {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 2px 5px;
    border: 1px solid var(--line); border-radius: 8px; background: var(--surface); cursor: pointer;
    font-size: 0.72rem; font-weight: 600; color: #3a4757; letter-spacing: 0; white-space: nowrap; user-select: none;
  }
  .icon-toggles.three label.icon-toggle { flex-direction: row; justify-content: center; gap: 4px; padding: 6px 4px; font-size: 0.8rem; }
  .icon-toggle svg { width: 22px; height: 22px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; color: var(--accent); }
  .icon-toggles.three .icon-toggle svg { width: 18px; height: 18px; }
  .panel label.icon-toggle:hover { background: var(--panel); }
  .panel label.icon-toggle:has(:checked) { background: var(--accent); border-color: var(--accent); color: #fff; }
  .icon-toggle:has(:checked) svg { color: #fff; }
  .icon-toggle:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* 右の欄: 地図に重ねているものの見方。オンにしたもの（説明が出ているもの）だけ見せる */
  .overlay-notes { display: grid; gap: 10px; border-bottom: 1px solid var(--line); padding-bottom: 10px; margin-bottom: 12px; }
  .overlay-notes:not(:has(.overlay-note > p:not([hidden]))), .overlay-note:not(:has(> p:not([hidden]))) { display: none; }
  .overlay-note h3 { display: flex; align-items: center; gap: 6px; margin: 0 0 2px; font-size: 0.85rem; }
  .overlay-note h3 svg { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .overlay-note p { margin: 0; }
  .overlay-note select { width: auto; margin: 0 0 4px; }
  .period-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  #period-label { font-weight: 700; font-variant-numeric: tabular-nums; }
  .period-control { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
  .period-control input { flex: 1; accent-color: var(--accent); }
  .play-button {
    flex: none; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line);
    background: var(--surface); cursor: pointer; font-size: 0.8rem;
  }
  .play-button[aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
  .play-button:disabled { opacity: 0.4; cursor: default; }
  .period-ticks { display: flex; justify-content: space-between; margin-left: 40px; font-size: 0.8rem; color: var(--muted); }
  .period-ticks span { cursor: pointer; }
  /* 背景の切替（地図の左上）。アイコンと短い名前のボタンを白い台の上に同じ幅で並べ、間に薄い区切り線を入れる。
     選んでいるものを青くする（左の欄のアイコンの切替と同じ色） */
  .base-switch {
    position: absolute; top: 10px; left: 32px; z-index: 3;
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; padding: 3px;
    border: 1px solid var(--line); border-radius: 10px;
    background: rgba(255,255,255,.96); box-shadow: 0 1px 4px rgba(0,0,0,.15);
  }
  .base-switch button {
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 5px 10px;
    border: 0; border-radius: 7px; background: none;
    font: inherit; font-size: 0.86rem; font-weight: 600; line-height: 1.4; color: #3a4757; white-space: nowrap; cursor: pointer;
  }
  /* 区切り線（選んでいるボタン・指を乗せたボタンの両隣では消す） */
  .base-switch button + button::before {
    content: ""; position: absolute; left: 0; top: 22%; bottom: 22%; width: 1px; background: var(--line-strong);
  }
  .base-switch button[aria-pressed="true"]::before, .base-switch button[aria-pressed="true"] + button::before,
  .base-switch button:hover::before, .base-switch button:hover + button::before { opacity: 0; }
  .base-switch svg {
    width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round; color: var(--accent);
  }
  .base-switch button:hover { background: var(--panel); }
  .base-switch button[aria-pressed="true"] { background: var(--accent); color: #fff; }
  .base-switch button[aria-pressed="true"] svg { color: #fff; }
  .base-switch button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .base-switch button[hidden] { display: none; }
  /* 背景ごとのパネル（航空写真の撮影年代・標高の色・土地利用の年度と凡例）。下の地図が透けて見えるよう半透明にし、
     文字が読みにくくならないよう少しぼかす */
  .base-panel {
    position: absolute; left: 50%; bottom: 40px; z-index: 3; transform: translateX(-50%);
    width: min(460px, calc(100% - 96px)); padding: 8px 12px 6px; border: 1px solid rgba(255,255,255,.6); border-radius: 10px;
    background: rgba(255,255,255,.72); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
  }
  .base-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .base-panel-head output, .base-panel-title { font-size: 1.15rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .base-panel-tools { display: flex; align-items: center; gap: 4px; }
  .base-close { border: 0; background: none; font-size: 1.3rem; line-height: 1; padding: 2px 6px; cursor: pointer; color: var(--muted); }
  .legend-toggle {
    padding: 2px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface);
    font: inherit; font-size: 0.75rem; color: var(--fg); cursor: pointer;
  }
  .legend-toggle::after { content: " ▾"; font-size: 0.7em; }
  .legend-toggle[aria-expanded="false"]::after { content: " ▸"; }
  .base-panel p { margin: 2px 0 0; }
  .base-panel [hidden] { display: none; }
  .base-panel .land-bins { font-size: 0.75rem; margin: 4px 0 2px; }
  .photo-era-ends { display: flex; justify-content: space-between; margin-left: 40px; }
  /* 標高の色の見本（帯と目盛り） */
  .relief-bar { height: 12px; margin-top: 6px; border-radius: 3px; border: 1px solid rgba(0,0,0,.15); }
  .relief-ticks { position: relative; height: 1.4em; margin: 2px 6px 0; }
  .relief-ticks span { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; }
  .relief-ticks span:first-child { transform: none; margin-left: -6px; }
  .relief-ticks span:last-child { transform: translateX(-100%); margin-left: 6px; }
  /* 地図の幅が狭いとき（スマホ・狭い窓）は、背景の切替を左端に寄せ、パネルはそのすぐ下に置く
     （地図の下側は縮尺・出典・ズームのボタンで混むため）。幅は landuse.ts の NARROW_MAP_PX と同じ */
  @container (max-width: 560px) {
    .base-switch { left: 10px; }
    .base-switch button { gap: 3px; padding: 5px 7px; font-size: 0.8rem; }
    .base-switch svg { width: 15px; height: 15px; }
    .base-panel { top: 52px; bottom: auto; left: 10px; right: 10px; width: auto; transform: none; padding: 6px 10px 4px; }
    .base-panel-head output, .base-panel-title { font-size: 1rem; }
  }
  /* 出典が長いとき（標高の「海域部は…」など）は右下で折り返し、左下の縮尺に重ねない */
  .map-wrap .maplibregl-ctrl-bottom-right { max-width: calc(100% - 120px); }
  .period-ticks span[aria-current="true"] { color: var(--fg); font-weight: 700; }
  .search { position: relative; }
  #search-results {
    position: absolute; z-index: 5; left: 0; right: 0; margin: 2px 0 0; padding: 0; list-style: none;
    background: #fff; border: 1px solid var(--line); border-radius: 6px; max-height: 50vh; overflow-y: auto;
    box-shadow: 0 4px 12px rgba(0,0,0,.12);
  }
  #search-results li { padding: 6px 10px; cursor: pointer; }
  #search-results li[aria-selected="true"], #search-results li:hover { background: var(--panel); }
  .legend { font-size: 0.85rem; }
  .legend p { margin: 0; }
  .legend-head { font-weight: 600; }
  .legend-head .muted { font-weight: 400; }
  /* 色の区切りは1本の帯にし、境目の下に値を書く */
  .legend-bar { display: flex; height: 14px; margin-top: 6px; border: 1px solid rgba(0,0,0,.2); border-radius: 3px; overflow: hidden; }
  .legend-bar span { flex: 1; }
  .legend-ticks { position: relative; height: 1.3em; margin: 2px 0 0; font-size: 0.72rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .legend-ticks span { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; }
  .legend-ticks.two { height: 2.5em; }
  .legend-ticks span.low { top: 1.2em; }
  .legend-ticks span::before { content: ""; position: absolute; left: 50%; top: -3px; height: 3px; border-left: 1px solid rgba(0,0,0,.35); }
  .legend-ticks span.low::before { top: calc(-3px - 1.2em); height: calc(3px + 1.2em); border-left-color: rgba(0,0,0,.2); }
  .legend-extra { display: flex; gap: 12px; margin-top: 4px !important; font-size: 0.75rem; color: var(--muted); }
  .legend-extra span { display: inline-flex; align-items: center; gap: 4px; }
  .legend .swatch { display: inline-block; width: 14px; height: 10px; border: 1px solid rgba(0,0,0,.2); flex: none; }
  .legend .swatch.blank { background: transparent; border-style: dashed; }
  .legend.dimmed { opacity: 0.45; }
  .detail .value { font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .detail h2 { margin: 0.2em 0; font-size: 1.2rem; }
  /* 地域の情報（#detail）: 上の地域 → 題名 → 値 → 順位・推移 → リンク・出典の順に並べる（設計変更記録 #135） */
  .detail .icon { width: 1em; height: 1em; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .detail-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0 6px; margin: 0; font-size: 0.82rem; color: var(--muted); }
  .detail-crumbs a { text-decoration: none; }
  .detail-crumbs a:hover { text-decoration: underline; }
  .detail-crumbs .sep { color: var(--line-strong); }
  #detail h2.detail-title { margin: 2px 0 10px; font-size: 1.35rem; line-height: 1.4; }
  .detail-title a { color: var(--ink); text-decoration: none; }
  .detail-title a .icon { width: 0.8em; height: 0.8em; margin-left: 4px; vertical-align: -0.02em; color: var(--accent); stroke-width: 2.2; }
  .detail-title a:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; }
  .detail-figure { padding: 10px 14px 12px; border-radius: 10px; background: var(--panel); }
  .detail-indicator { margin: 0; font-size: 0.9rem; font-weight: 700; color: #33414f; line-height: 1.5; }
  .detail-indicator span { margin-left: 8px; font-weight: 400; font-size: 0.8rem; color: var(--muted); }
  .detail-figure .value { line-height: 1.3; margin: 2px 0; }
  .rank h3, .detail-compare h3, .detail .trend caption {
    margin: 0 0 4px; font-size: 0.85rem; font-weight: 700; color: #33414f; text-align: left;
  }
  .rank h3 span, .detail-compare h3 span { margin-left: 8px; font-weight: 400; font-size: 0.78rem; color: var(--muted); }
  .rank, .detail-compare { margin: 16px 0 0; }
  .rank dl, .detail-compare ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .rank dl > div, .detail-compare li {
    display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
    padding: 6px 2px; border-bottom: 1px solid var(--line); font-size: 0.88rem;
  }
  .rank dt .of { margin-left: 6px; font-size: 0.78rem; color: var(--muted); }
  .rank dd { margin: 0; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .rank dd strong { font-size: 1.1rem; margin-right: 1px; }
  .detail-compare strong { white-space: nowrap; font-variant-numeric: tabular-nums; }
  #detail .trend { margin: 16px 0 0; }
  .detail-links { margin: 18px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .detail-links a {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 9px 4px; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 0.9rem; line-height: 1.5;
  }
  .detail-links a:hover { background: var(--panel); }
  .detail-links a span { min-width: 0; }
  .detail-links small { display: block; font-size: 0.75rem; color: var(--muted); }
  .detail-links .icon { width: 16px; height: 16px; color: var(--muted); }
