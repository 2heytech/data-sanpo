---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import FeedbackLink from "../../components/FeedbackLink.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { readFileSync } from "node:fs";
import { DATA_BASE, RELEASE, loadIndicators } from "../../lib/data";
import { RELIEF_GRADIENT, RELIEF_STOPS, reliefAt } from "../../map/relief";
const { version } = JSON.parse(readFileSync("node_modules/maplibre-gl/package.json", "utf8"));
const maplibreUrl = `/vendor/maplibre-gl-${version}/maplibre-gl.mjs`;
// 右の欄の「〇〇の公式サイト」の URL 一覧（pages/official-sites.json.ts）。架空の地名を使う開発用データでは出さない
const officialSitesUrl = RELEASE.is_fixture ? "" : "/official-sites.json";
// 指標の選択画面で使う分類のアイコン（地図の処理が複製して使う）。点レイヤーのカテゴリも含める
// 左の欄の切替アイコン（24×24 の線画）。name は短い名前、title は説明つきの名前（地図の凡例の見出しにも使う）
const ICON: Record<string, string> = {
  colors: '<rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1" fill="currentColor" fill-opacity=".85"/><rect x="13" y="3.5" width="7.5" height="7.5" rx="1" fill="currentColor" fill-opacity=".45"/><rect x="3.5" y="13" width="7.5" height="7.5" rx="1" fill="currentColor" fill-opacity=".25"/><rect x="13" y="13" width="7.5" height="7.5" rx="1"/>',
  labels: '<path d="M4 6V4.5h16V6M12 4.5v15M8.5 19.5h7"/>',
  values: '<path d="M4.5 8 6.5 6.5V17M4.5 17h4M10.5 8.5a2.2 2.2 0 0 1 4.3.6c0 2.6-4.3 4.6-4.3 7.9h4.6M17 7h3.5l-2 3.3a2.9 2.9 0 1 1-2 4.9"/>',
  stations: '<rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 10h14M8.5 14h.01M15.5 14h.01M8 17l-2.5 4M16 17l2.5 4"/>',
  schools: '<path d="M3 20h18M5 20V10l7-5 7 5v10"/><path d="M10 20v-5h4v5M12 5V2.5h3"/>',
  land: '<circle cx="12" cy="12" r="9"/><path d="M8.5 7 12 12l3.5-5M12 12v5.5M9 12.5h6M9 15h6"/>',
  nursery: '<circle cx="8" cy="5.5" r="2.5"/><path d="M4 21v-7a4 4 0 0 1 8 0v7"/><circle cx="17" cy="10" r="2"/><path d="M14 21v-4a3 3 0 0 1 6 0v4M12 15h2"/>',
  airports: '<path d="M21 15.5v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0v5l-8 5v2l8-2.5v5l-2 1.5V21l3.5-1 3.5 1v-1.5L13 18v-5z"/>',
  ports: '<circle cx="12" cy="5" r="2"/><path d="M12 7v14M7 10h10M4.5 14.5A7.5 7.5 0 0 0 12 21a7.5 7.5 0 0 0 7.5-6.5M3 14.5h3M18 14.5h3"/>',
  bunka: '<path d="M3 7.5h18M5 4.5h14M6.5 7.5V20M17.5 7.5V20M4 11h16M9.5 11v9M14.5 11v9M3 20h18"/>',
  michi: '<path d="M3 11 12 4.5 21 11"/><path d="M5.5 9.5V16h13V9.5M10 16v-4h4v4"/><path d="M8 21l1-3M16 21l-1-3M12 19.5v1.5"/>',
  weather: '<circle cx="9" cy="9" r="3.5"/><path d="M9 2.5v1.5M2.5 9H4M4.4 4.4l1.1 1.1M13.6 4.4l-1.1 1.1"/><path d="M8 20h10a3.5 3.5 0 0 0 0-7 5 5 0 0 0-9.6 1.5A2.8 2.8 0 0 0 8 20z"/>',
  landuse: '<rect x="3.5" y="3.5" width="17" height="17" rx="1.5"/><path d="M12 3.5v17M3.5 12h17M5.5 9.5l4-4M5.5 7l1.5-1.5M14 20.5l6.5-6.5M16.5 20.5l4-4"/>',
  // 背景の切替（地図の左上）のアイコン: 地図・航空写真・標高
  pale: '<path d="M9 4.5 3.5 6.5v13l5.5-2 6 2 5.5-2v-13l-5.5 2-6-2z"/><path d="M9 4.5v13M15 6.5v13"/>',
  photo: '<rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m3.5 17 5-4.5 3.5 3 3-2.5 5.5 4.5"/>',
  relief: '<path d="M2 20 9 7.5l3.5 5.5 2.5-3.5L22 20z"/><path d="M7.2 10.7 9 12l1.8-1.3"/>',
};
const VIEW_TOGGLES = [
  { id: "colors-toggle", name: "色分け", title: "色分けを表示", icon: ICON.colors },
  { id: "labels-toggle", name: "地名", title: "地名を表示", icon: ICON.labels },
  { id: "values-toggle", name: "数値", title: "地名の下に数値を表示", icon: ICON.values },
];
const OVERLAYS = [
  { id: "stations-toggle", note: "stations-legend", name: "駅", title: "駅（乗降客数）", icon: ICON.stations },
  { id: "airports-toggle", note: "airports-legend", name: "空港", title: "空港（乗降客数）", icon: ICON.airports },
  { id: "ports-toggle", note: "ports-legend", name: "港", title: "港（船の乗降人員）", icon: ICON.ports },
  { id: "schools-toggle", note: "schools-legend", name: "小中学校", title: "公立小中学校（児童・生徒数）", icon: ICON.schools },
  { id: "land-toggle", note: "land-legend", name: "地価", title: "地価（地価公示・都道府県地価調査）", icon: ICON.land },
  { id: "nursery-toggle", note: "nursery-legend", name: "保育所", title: "保育所・こども園（定員）", icon: ICON.nursery },
  { id: "michi-toggle", note: "michi-legend", name: "道の駅", title: "道の駅", icon: ICON.michi },
  { id: "bunka-toggle", note: "bunka-legend", name: "文化財", title: "国指定文化財", icon: ICON.bunka },
  { id: "weather-toggle", note: "weather-legend", name: "天気", title: "天気（気象庁の観測所の平年値）", icon: ICON.weather },
];
// 背景（地図の左上で、どれか1つを選ぶ。#128）。標高・土地利用は左の欄の「地図に重ねる」から移した
const BASES = [
  { id: "pale", name: "地図", title: "地図（淡色地図）", icon: ICON.pale },
  { id: "photo", name: "航空写真", title: "航空写真（昔の写真も）", icon: ICON.photo },
  { id: "relief", name: "標高", title: "標高（色別標高図）", icon: ICON.relief },
  { id: "landuse", name: "土地利用", title: "土地利用（100m四方のマス）", icon: ICON.landuse },
];
const categories = [...new Set([...loadIndicators().map((i) => i.category), "交通", "教育", "地価", "子育て", "観光", "天気"])];
---
<Base menu="地図" preload={maplibreUrl} description="全国の市区町村・町丁目を、人口・高齢化・年収・地価などで色分けした地図。地名で探して拡大すれば、となりのまちとの違いや年ごとの移り変わりがひと目で分かります。" wide>
  <div class="map-app" data-base={DATA_BASE} data-maplibre={maplibreUrl} data-official-sites={officialSitesUrl}>
    <aside class="panel panel-conditions" aria-label="表示する条件">
      {/* 範囲と地域の検索はあまり使わないので、最初は畳んでおく（開いた状態は覚えない、#103） */}
      <details class="move-tools">
        <summary>範囲・地域を検索</summary>
        <div class="move-tools-body">
          <div class="field region">
            <label for="region-jump">範囲</label>
            <div class="region-row">
              <select id="region-jump">
                {/* 公開版の都道府県から地図の処理で作る（都道府県コードの順） */}
                <option value="mainland">東京都（区部・多摩）</option>
              </select>
              <button type="button" id="locate" class="locate" aria-label="現在地へ移動" title="現在地へ移動">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="2" fill="currentColor"/><path d="M12 2v3.5M12 18.5V22M2 12h3.5M18.5 12H22"/></svg>
              </button>
            </div>
          </div>
          <div class="search">
            <label for="search-input">地域を検索</label>
            <input id="search-input" type="search" placeholder="例: 新宿区、本町一丁目" autocomplete="off"
                   role="combobox" aria-expanded="false" aria-controls="search-results" />
            <ul id="search-results" role="listbox" hidden></ul>
          </div>
        </div>
      </details>
      <div class="field">
        <label for="indicator-open">指標</label>
        {/* 押すと指標の選択画面を開く。選んだ指標は下の select に入れる（select は状態の保持用） */}
        <button type="button" id="indicator-open" class="indicator-open" aria-haspopup="dialog">
          <span class="io-icon" aria-hidden="true"></span><span class="io-name"></span><span class="io-change">変更</span>
        </button>
        <select id="indicator-select" hidden aria-hidden="true" tabindex="-1"></select>
      </div>
      {/* 色分けの単位（自動・都道府県・市区町村・町丁目）の切替と、対象の都道府県（#146） */}
      <div id="indicator-scope" class="scope small"></div>
      {/* 犯罪など、種別と基準（件数・人口当たり）を切り替える指標 */}
      <div id="facets" class="field facets" hidden>
        <label id="facet-type-wrap" class="inline">種別 <select id="facet-type"></select></label>
        <label id="facet-basis-wrap" class="inline">基準 <select id="facet-basis"></select></label>
      </div>
      <div class="field period">
        <div class="period-head">
          <label for="period-range">時点</label>
          <output id="period-label" for="period-range"></output>
        </div>
        <div class="period-control">
          <button type="button" id="period-play" class="play-button" aria-pressed="false" aria-label="時点を順に再生">▶</button>
          <input id="period-range" type="range" min="0" max="0" step="1" value="0" />
        </div>
        <div id="period-ticks" class="period-ticks" aria-hidden="true"></div>
        <p id="period-note" class="muted small" hidden></p>
        <label id="aggregate-wrap" class="inline check" hidden><input type="checkbox" id="aggregate-toggle" />
          <span id="aggregate-label">直近5年の合計で見る</span></label>
      </div>
      <div id="legend" class="legend" aria-live="polite"></div>
      {/* 表示に関する切替（色分け・地名・数値）は1行のアイコン、地図に重ねるものはアイコンの並び。
           細かい説明は地図の右上の凡例に出す（#97・#139）。チェックボックスは見えないだけで、id と動きはそのまま */}
      <fieldset class="field view-options">
        <legend>表示</legend>
        <div class="icon-toggles three">
          {VIEW_TOGGLES.map((t) => (
            <label class="icon-toggle" title={t.title}>
              <input type="checkbox" id={t.id} checked class="vh" />
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /><span>{t.name}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <fieldset class="field view-options">
        <legend>地図に重ねる</legend>
        <div class="icon-toggles">
          {OVERLAYS.map((t) => (
            <label class="icon-toggle" title={t.title}>
              <input type="checkbox" id={t.id} class="vh" />
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /><span>{t.name}</span>
            </label>
          ))}
        </div>
      </fieldset>
    </aside>
    <div class="map-wrap">
      <div id="map" role="region" aria-label="地図"></div>
      {/* 背景: 地図・航空写真（昔の写真も）・標高・土地利用のどれか1つを地図の左上で選ぶ。航空写真の撮影年代・土地利用の年度・
           標高の色の見本は、選んだものだけ地図の上のパネルに出す（ふだんは地図の下側、地図の幅が狭いときは切替のすぐ下。#128） */}
      <div class="base-switch" role="group" aria-label="背景">
        {BASES.map((b) => (
          <button type="button" data-basemap={b.id} aria-pressed={b.id === "pale" ? "true" : "false"} title={b.title}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={b.icon} /><span>{b.name}</span>
          </button>
        ))}
      </div>
      <section id="photo-panel" class="base-panel" aria-label="航空写真の撮影年代" hidden>
        <div class="base-panel-head">
          <output id="photo-era-label" for="photo-era-range" aria-live="polite"></output>
          <button type="button" class="base-close" aria-label="航空写真を閉じる" title="航空写真を閉じる">×</button>
        </div>
        <div class="period-control">
          <button type="button" id="photo-era-play" class="play-button" aria-pressed="false" aria-label="撮影年代を順に再生">▶</button>
          <input id="photo-era-range" type="range" min="0" max="0" step="1" value="0" aria-label="撮影年代" />
        </div>
        <div id="photo-era-ends" class="photo-era-ends muted small" aria-hidden="true"></div>
        <p id="photo-note" class="muted small"></p>
      </section>
      <section id="relief-panel" class="base-panel" aria-label="標高の色" hidden>
        <div class="base-panel-head">
          <span class="base-panel-title">標高（色別標高図）</span>
          <button type="button" class="base-close" aria-label="標高を閉じる" title="標高を閉じる">×</button>
        </div>
        <div class="relief-bar" style={`background: ${RELIEF_GRADIENT}`} aria-hidden="true"></div>
        <div class="relief-ticks muted small" aria-hidden="true">
          {RELIEF_STOPS.map((s, i) => s.tick && <span style={`left: ${reliefAt(i) * 100}%`}>{s.tick}</span>)}
        </div>
        <p id="relief-note" class="muted small" hidden></p>
      </section>
      <section id="landuse-panel" class="base-panel" aria-label="土地利用図の年度" hidden>
        <div class="base-panel-head">
          <output id="landuse-year-label" for="landuse-year" aria-live="polite"></output>
          <span class="base-panel-tools">
            <button type="button" class="base-close" aria-label="土地利用を閉じる" title="土地利用を閉じる">×</button>
          </span>
        </div>
        <div class="period-control">
          <button type="button" id="landuse-play" class="play-button" aria-pressed="false" aria-label="年度を順に再生">▶</button>
          <input id="landuse-year" type="range" min="0" max="0" step="1" value="0" aria-label="土地利用の年度" />
        </div>
        <div id="landuse-year-ticks" class="period-ticks" aria-hidden="true"></div>
        {/* 凡例の枠の上のフチに開け閉めのつまみを付ける（#165） */}
        <div class="land-legend">
          <button type="button" id="landuse-legend-toggle" class="legend-toggle" aria-expanded="true" aria-controls="landuse-legend"
                  aria-label="凡例を畳む" title="凡例を畳む">
            <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1.5 6.5 6 2l4.5 4.5" /></svg>
          </button>
          <div id="landuse-legend" class="land-bins"></div>
        </div>
        <p id="landuse-note" class="muted small" hidden></p>
      </section>
      {/* 地図に重ねている点の凡例（左の欄のアイコンでオンにしたものだけ出す）。地図の右上（地図の幅が狭いときは左下）に置き、
           見出しのボタンで畳める（#139）。土地利用の凡例は地図の上のパネルだけに出す（#162） */}
      <section class="overlay-notes" aria-label="地図に重ねているものの凡例">
        <button type="button" id="overlay-notes-toggle" class="overlay-notes-toggle" aria-expanded="true" aria-controls="overlay-notes-body">凡例</button>
        <div id="overlay-notes-body" class="overlay-notes-body">
          {OVERLAYS.map((t) => (
            <div class="overlay-note">
              <h3><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />{t.title}</h3>
              {t.id === "weather-toggle" && <select id="weather-select" class="weather-select" aria-label="天気の指標" hidden></select>}
              <p id={t.note} class="muted small" hidden></p>
            </div>
          ))}
        </div>
      </section>
      {/* 地点の情報（点を押したとき）。地図の処理がこの要素ごと地図の上のポップアップに移して、押した点から出す（#139） */}
      <div id="point-popup" class="point-popup" aria-label="地点の情報" hidden>
        <section id="pick-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="station-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="airport-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="port-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="school-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="land-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="nursery-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="michi-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="bunka-detail" class="detail station-detail" aria-live="polite" hidden></section>
        <section id="weather-detail" class="detail station-detail" aria-live="polite" hidden></section>
      </div>
      {/* 左右の欄の表示・非表示（地図を広く見る） */}
      <button type="button" class="panel-toggle left" data-panel="left" aria-pressed="false" aria-label="条件の欄を隠す" title="条件の欄を隠す">‹</button>
      <button type="button" class="panel-toggle right" data-panel="right" aria-pressed="false" aria-label="情報の欄を隠す" title="情報の欄を隠す">›</button>
    </div>
    <aside class="panel panel-info" aria-label="地域の情報">
      <section id="detail" class="detail" aria-live="polite">
        <p class="muted">地図をクリックするか、地域名で検索してください。</p>
      </section>
      <p class="muted small panel-foot">
        背景地図: <a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener">地理院タイル</a>。
        <a href="/sources/">統計の出典</a>・<a href="/about/#terms">利用規約</a>・<FeedbackLink />
      </p>
      <AdSlot name="map" />
    </aside>
    {/* 指標の選択画面（地図の上に重ねて開く。スマホでは全画面） */}
    <dialog id="indicator-picker" class="picker" aria-labelledby="picker-title">
      <div class="picker-head">
        <h2 id="picker-title">指標をえらぶ</h2>
        <input id="picker-search" type="search" placeholder="指標名で探す（例: 人口、犯罪）" autocomplete="off" aria-label="指標名で探す" />
        <button type="button" class="picker-close" aria-label="閉じる">×</button>
      </div>
      <div class="picker-body">
        <nav class="picker-nav" aria-label="分類"></nav>
        <div class="picker-list" tabindex="-1" autofocus></div>
      </div>
    </dialog>
    {/* 画像の保存・コピーとリンクのコピー（地図の右下のボタンで開く。#153・#156）。画像は表示中の地図からブラウザの中で作る。
         リンクには画面で切り替えたもの（背景・重ねた点など）を入れ、地図の位置と縮尺はチェックで外せる（#175）。SNS などへ送るボタンは置かない */}
    <dialog id="share-dialog" class="share-dialog" aria-labelledby="share-title">
      <div class="share-head">
        <h2 id="share-title">画像とリンクのコピー</h2>
        <button type="button" class="share-close" aria-label="閉じる">×</button>
      </div>
      <div class="share-body">
        <div class="share-preview">
          <p id="share-status" class="muted small">画像を作っています…</p>
          <img id="share-image" alt="" hidden />
        </div>
        <div class="share-actions">
          <a id="share-download" class="button" aria-disabled="true">画像を保存</a>
          <button type="button" id="share-image-copy" class="button secondary" disabled hidden>画像をコピー</button>
        </div>
        <h3>共有用のリンク</h3>
        <div class="share-link">
          <input id="share-url" type="text" readonly aria-label="この地図のリンク" />
          <button type="button" id="share-copy" class="button secondary">コピー</button>
        </div>
        <label class="share-view"><input type="checkbox" id="share-view" checked />地図の位置と縮尺も入れる</label>
        <ul class="share-notes muted small">
          <li>画像は、いま表示している地図にこの端末の中で題名・凡例・出典を書き足して作ります。コピーできないときは、保存するか、画像を長押し（パソコンでは右クリック）してコピーしてください。</li>
          <li>リンクには、指標・時点・選んだ地域・色分けの単位・背景（航空写真の年代、土地利用の年度）・重ねた地点・表示の切替が入ります。開くと同じ表示になります。</li>
          <li>「地図の位置と縮尺も入れる」を外すと、開いたときは選んだ地域（なければ日本全体）を表示します。自宅の近くや現在地を見ているときは外してください。</li>
        </ul>
      </div>
    </dialog>
    <template id="category-icons">
