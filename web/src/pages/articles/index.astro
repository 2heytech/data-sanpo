---
// 寄り道の一覧（設計変更記録 #126）
import Base from "../../layouts/Base.astro";
import { formatDate, publishedArticles } from "../../lib/articles";

const list = publishedArticles().sort((a, b) => (b.updated ?? b.published).localeCompare(a.updated ?? a.published));
---
<Base menu="寄り道" description="人口が増え続けたまち、日本一広い市、標高の高いまち…。公開データの数字と地図から、全国の都道府県・市区町村の意外な姿を読み解く記事の一覧です。">
  <header class="page-head">
    <h1>寄り道</h1>
    <p class="lead">地図から少し寄り道して、数字から地域の特徴を読み解く記事です。</p>
    <div class="actions">
      <a class="button secondary" href="/guide/">データさんぽの使い方</a>
    </div>
  </header>
  <section class="sheet">
    <ul class="article-list">
      {list.map((a) => (
        <li>
          <a href={`/articles/${a.slug}/`}>{a.title}</a>
          <p>{a.description}</p>
          <p class="muted"><time datetime={a.updated ?? a.published}>{formatDate(a.updated ?? a.published)}</time></p>
        </li>
      ))}
    </ul>
  </section>
</Base>
