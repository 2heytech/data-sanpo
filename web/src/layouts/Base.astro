---
import FeedbackLink from "../components/FeedbackLink.astro";
import { ADSENSE_CLIENT } from "../lib/ads";
import { CF_WEB_ANALYTICS_TOKEN } from "../lib/analytics";
import { RELEASE, loadAreas } from "../lib/data";
import { ALLOW_INDEXING } from "../lib/indexing";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  preload?: string;
  /** 見ている都道府県の名前（地域ページなど）。ロゴの横に出す */
  prefecture?: string;
  /** title をそのまま使う（サイト名を後ろに付けない）。トップページ用 */
  titleIsFull?: boolean;
  /** ページの構造化データ（寄り道の Article、パンくずなど）。JSON-LD にして head に置く。複数あるときは配列で */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** SNS で共有されたときの画像（都道府県ページ・寄り道の地図の画像。設計変更記録 #142）。ないときはサイト共通の画像 */
  image?: { path: string; alt: string };
}
const { title, description, wide = false, preload, prefecture, titleIsFull = false, structuredData, image } = Astro.props;
const SITE_NAME = "データさんぽ";
const fullTitle = titleIsFull || title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// SNS で共有されたときの画像（1200×630）。ページの画像がなければ全ページ共通の画像（作り方は scripts/og-image.mjs）
const ogPath = image?.path ?? "/og.png";
const ogImage = Astro.site ? new URL(ogPath, Astro.site).href : ogPath;
const ogAlt = image?.alt ?? `${SITE_NAME} — 全国の市区町村・町丁目を公開データで色分けした地図`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const indexable = ALLOW_INDEXING;
// ロゴの横の都道府県名。見ている都道府県が決まるページ（地域ページ、地図で選んだ・拡大したとき）だけ出し、
// 決まらないページ（トップ・全国を見ているとき）は出さない。1つの都道府県だけの公開版では常にその名前
const { prefectures } = loadAreas();
const areaLabel = prefecture ?? (prefectures.length === 1 ? prefectures[0].name : "");
// wide は、狭い画面で省く先頭の文字（6項目を390px幅の1行に収めるため。global.css の 1180px 以下）。
// icon は 24×24 のピクトグラム（色はロゴの藍。設計変更記録 #141）
const nav: { href: string; label: string; wide?: string; icon: string }[] = [
  // 棒グラフ
  { href: "/#indicators", label: "指標", icon: '<path d="M4 3.5v17h16.5"/><path d="M8.5 16.5v-4M13 16.5V7M17.5 16.5v-6.5"/>' },
  // 日本の形（線では細すぎて読めないので塗る）
  { href: "/prefectures/", label: "都道府県", icon: '<g fill="currentColor" stroke-width="1"><path d="M18.6 8 19 11.2 17.6 14 14.6 15.6 11 16.2 7.4 16.6 5.4 16.4 5.4 14 8.2 13.4 11.4 12.6 13.6 11.2 15.2 9.6 16 7.6z"/><path d="M15.8 4.2 18.8 1.8 22 3.6 21 6 18 6.8z"/><path d="M8 17.8 11.6 17.6 11 19.4 8.6 19.6z"/><path d="M2.6 17.4 5.6 17.6 5.8 20.4 4 22 2.4 20.4z"/></g>' },
  // 町の建物
  { href: "/areas/", label: "市区町村", icon: '<path d="M3 20.5h18"/><path d="M5 20.5V10h5"/><path d="M10 20.5V4h9v16.5"/><path d="M7.5 13.5v.1M7.5 17v.1M13.5 8h2M13.5 11.5h2M13.5 15h2"/>' },
  // 新聞（記事）
  { href: "/articles/", label: "寄り道", icon: '<path d="M7.5 17.5V5.5a1 1 0 0 1 1-1h10.5a1 1 0 0 1 1 1V18a2.5 2.5 0 0 1-2.5 2.5H5"/><path d="M7.5 9H4.5a1 1 0 0 0-1 1v8a2.5 2.5 0 0 0 5 0"/><path d="M11 8h6M11 11.5h6M11 15h4"/>' },
  // 書類
  { href: "/sources/", label: "出典", icon: '<path d="M6 3h8.5L19 7.5V21H6z"/><path d="M14.5 3v4.5H19"/><path d="M9 12h7M9 15.5h7"/>' },
  // 案内の i
  { href: "/about/", label: "サイトについて", wide: "この", icon: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.1"/>' },
];
const onMap = Astro.url.pathname.startsWith("/map/");
// 検索結果のサイト名に「データさんぽ」を使ってもらうため、トップページにだけ WebSite の構造化データを置く（設計変更記録 #85）
const websiteLd = Astro.url.pathname === "/" && Astro.site
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE_NAME,
      alternateName: ["データ散歩", Astro.site.host],
      url: new URL("/", Astro.site).href,
    })
  : "";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    {/* 旧アドレス（workers.dev）と www で開かれたら独自ドメインへ移す（設計変更記録 #61）。
        www は Cloudflare の Redirect Rules でも転送する。workers.dev はそこで扱えないのでここで移す。
        is:inline のスクリプトはそのままページに出るので、説明はここに書き、workers.dev はアカウント名を含めずに末尾で見る（#143） */}
    <script is:inline define:vars={{ siteHost: Astro.site?.host ?? "" }}>
      if (siteHost && (location.hostname.endsWith(".workers.dev") || location.hostname === "www." + siteHost)) {
        location.replace("https://" + siteHost + location.pathname + location.search + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {/* 検索結果やおすすめに、地図の画像を大きく出してよいことを伝える（設計変更記録 #142） */}
    {indexable && <meta name="robots" content="max-image-preview:large" />}
    <meta property="og:site_name" content={SITE_NAME} />
    {websiteLd && <script type="application/ld+json" set:html={websiteLd} />}
    {(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : []).map((d) => (
      <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, "\\u003c")} />
    ))}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preload && <link rel="modulepreload" href={preload} />}
    <script>
      // 外部サイトへのリンクは別タブで開く（地図の情報欄など、後から差し込まれるリンクも含む）
      document.addEventListener("click", (e) => {
        // ご要望フォームには、開いていたページの URL（地図の表示状態を含む）を入れて開く
        const fb = (e.target as Element | null)?.closest?.("a[data-feedback-prefill]") as HTMLAnchorElement | null;
        if (fb) fb.href = fb.dataset.feedbackPrefill + encodeURIComponent(location.href);
        const a = (e.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
        if (a && a.origin !== location.origin && /^https?:$/.test(a.protocol) && !a.target) {
          a.target = "_blank";
          a.rel = "noopener";
        }
      });
    </script>
    {CF_WEB_ANALYTICS_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN })}></script>
    )}
    {ADSENSE_CLIENT && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"></script>
    )}
  </head>
  <body class={wide ? "wide" : ""}>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <a class="brand" href="/"><img src="/logo.svg" alt={SITE_NAME} width="164" height="34" /></a>
      {/* 見ている都道府県。地図では地図の動きに合わせて書き換える（map/app.ts） */}
      <span class="area-chip" id="area-chip" title="見ている都道府県" hidden={!areaLabel}>{areaLabel}</span>
      {/* パソコンではメニューの右端に「地図をひらく」を並べる。スマホではメニューを2行目に回し、
           「地図をひらく」はロゴの行に置いて切れないようにする（global.css の 720px 以下） */}
      <div class="header-links">
        <nav aria-label="サイト内">
          {nav.map(({ href, label, wide, icon }) => (
            <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
              <span>{wide && <span class="nav-wide">{wide}</span>}{label}</span>
            </a>
          ))}
        </nav>
        <a class="nav-cta" href="/map/" aria-current={onMap ? "page" : undefined}>地図をひらく</a>
      </div>
    </header>
    {RELEASE.is_fixture && (
      <p class="fixture-banner" role="note">
        開発用の架空データを表示しています。地名・数値は実在しません。
      </p>
    )}
    <main id="main"><slot /></main>
    {!wide && (
      <footer class="site-footer">
        <div class="inner">
          <div>
            <a class="brand-foot" href="/"><img src="/logo-dark.svg" alt={SITE_NAME} width="155" height="32" /></a>
            <p class="small">全国の都道府県・市区町村・町丁目を、国勢調査などの公開データで色分けした地図サイトです。</p>
          </div>
          <div>
            <h2>見る</h2>
            <ul>
              <li><a href="/map/">地図</a></li>
              <li><a href="/#indicators">指標の一覧</a></li>
              <li><a href="/prefectures/">都道府県の一覧</a></li>
              <li><a href="/areas/">市区町村の一覧</a></li>
              <li><a href="/articles/">寄り道</a></li>
              <li><a href="/guide/">使い方</a></li>
            </ul>
          </div>
          <div>
            <h2>このサイトについて</h2>
            <ul>
              <li><a href="/sources/">出典と利用条件</a></li>
              <li><a href="/about/#terms">利用規約</a></li>
              <li><a href="/about/#privacy">プライバシー</a></li>
              <li><FeedbackLink /></li>
            </ul>
          </div>
          <p class="fine">
            背景地図: <a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener">地理院タイル</a>。
            統計は各出典を加工して作成しています。データ版 {RELEASE.release_id}
            <span class="operator">運営: へいてく</span>
          </p>
        </div>
      </footer>
    )}
  </body>
</html>
