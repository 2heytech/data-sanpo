---
import FeedbackLink from "../components/FeedbackLink.astro";
import { ADSENSE_CLIENT } from "../lib/ads";
import { CF_WEB_ANALYTICS_TOKEN } from "../lib/analytics";
import { RELEASE, loadAreas } from "../lib/data";
import { ALLOW_INDEXING } from "../lib/indexing";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  preload?: string;
  /** 見ている都道府県の名前（地域ページなど）。ロゴの横に出す */
  prefecture?: string;
}
const { title, description, wide = false, preload, prefecture } = Astro.props;
const SITE_NAME = "データさんぽ";
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const indexable = ALLOW_INDEXING;
// ロゴの横の都道府県名。見ている都道府県が決まるページ（地域ページ、地図で選んだ・拡大したとき）だけ出し、
// 決まらないページ（トップ・全国を見ているとき）は出さない。1つの都道府県だけの公開版では常にその名前
const { prefectures } = loadAreas();
const areaLabel = prefecture ?? (prefectures.length === 1 ? prefectures[0].name : "");
const nav = [
  ["/#indicators", "指標"],
  ["/sources/", "出典"],
  ["/about/", "このサイトについて"],
];
const onMap = Astro.url.pathname.startsWith("/map/");
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ siteHost: Astro.site?.host ?? "" }}>
      // 旧アドレス（workers.dev）と www で開かれたら独自ドメインへ移す（設計変更記録 #61）。
      // www は Cloudflare の Redirect Rules でも転送する。workers.dev はそこで扱えないのでここで移す。
      if (siteHost && (location.hostname === "tokyo-data-map.2heytech.workers.dev" || location.hostname === "www." + siteHost)) {
        location.replace("https://" + siteHost + location.pathname + location.search + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preload && <link rel="modulepreload" href={preload} />}
    <script>
      // 外部サイトへのリンクは別タブで開く（地図の情報欄など、後から差し込まれるリンクも含む）
      document.addEventListener("click", (e) => {
        // ご要望フォームには、開いていたページの URL（地図の表示状態を含む）を入れて開く
        const fb = (e.target as Element | null)?.closest?.("a[data-feedback-prefill]") as HTMLAnchorElement | null;
        if (fb) fb.href = fb.dataset.feedbackPrefill + encodeURIComponent(location.href);
        const a = (e.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
        if (a && a.origin !== location.origin && /^https?:$/.test(a.protocol) && !a.target) {
          a.target = "_blank";
          a.rel = "noopener";
        }
      });
    </script>
    {CF_WEB_ANALYTICS_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN })}></script>
    )}
    {ADSENSE_CLIENT && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"></script>
    )}
  </head>
  <body class={wide ? "wide" : ""}>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <a class="brand" href="/"><img src="/logo.svg" alt={SITE_NAME} width="164" height="34" /></a>
      <!-- 見ている都道府県。地図では地図の動きに合わせて書き換える（map/app.ts） -->
      <span class="area-chip" id="area-chip" title="見ている都道府県" hidden={!areaLabel}>{areaLabel}</span>
      <nav aria-label="サイト内">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>{label}</a>
        ))}
        <a class="nav-cta" href="/map/" aria-current={onMap ? "page" : undefined}>地図をひらく</a>
      </nav>
    </header>
    {RELEASE.is_fixture && (
      <p class="fixture-banner" role="note">
        開発用の架空データを表示しています。地名・数値は実在しません。
      </p>
    )}
    <main id="main"><slot /></main>
    {!wide && (
      <footer class="site-footer">
        <div class="inner">
          <div>
            <a class="brand-foot" href="/"><img src="/logo-dark.svg" alt={SITE_NAME} width="155" height="32" /></a>
            <p class="small">全国の都道府県・市区町村・町丁目を、国勢調査などの公開データで色分けした地図サイトです。</p>
          </div>
          <div>
            <h2>見る</h2>
            <ul>
              <li><a href="/map/">地図</a></li>
              <li><a href="/#indicators">指標の一覧</a></li>
              <li><a href="/#areas">地域から探す</a></li>
            </ul>
          </div>
          <div>
            <h2>このサイトについて</h2>
            <ul>
              <li><a href="/sources/">出典と利用条件</a></li>
              <li><a href="/about/#terms">利用規約</a></li>
              <li><a href="/about/#privacy">プライバシー</a></li>
              <li><FeedbackLink /></li>
            </ul>
          </div>
          <p class="fine">
            背景地図: <a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener">地理院タイル</a>。
            統計は各出典を加工して作成しています。データ版 {RELEASE.release_id}
          </p>
        </div>
      </footer>
    )}
  </body>
</html>
