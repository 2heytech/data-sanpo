---
// 地域の紹介の文（「あらまし」。設計変更記録 #164）。公式サイトなどで確かめた事実の短いまとめと、そのすぐ下に出典・確かめた日。
// 見出しは付けず、「データで見る〇〇」の題名の下に、データの概要と合わせて出す（設計変更記録 #166）
import { checkedLabel, type Aramashi } from "../lib/aramashi";

interface Props { aramashi: Aramashi }
const { aramashi } = Astro.props;
// 資料の名前の中のかぎかっこは、外のかぎかっこと重ならないよう二重かぎかっこにする
const quoted = (title: string) => title.replace(/「/g, "『").replace(/」/g, "』");
---
<p class="aramashi">{aramashi.text.join("")}</p>
<p class="aramashi-source muted">出典：{aramashi.sources.map((s, i) => (
  <>{i > 0 && "、"}<a href={s.url} target="_blank" rel="noopener">{s.publisher}「{quoted(s.title)}」</a></>
))}（{checkedLabel(aramashi.checked)}に確認）。資料で確かめた事実を、データさんぽが短くまとめたものです。</p>

<style>
  .aramashi { margin-bottom: 0.3em; line-height: 1.9; }
  .aramashi-source { margin-top: 0; font-size: 0.82rem; line-height: 1.6; }
</style>
