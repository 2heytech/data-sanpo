---
// 地域ページの「〇〇のあらまし」（設計変更記録 #164）。公式サイトなどで確かめた事実の短いまとめと、出典・確かめた日
import { checkedLabel, type Aramashi } from "../lib/aramashi";

interface Props { name: string; aramashi: Aramashi }
const { name, aramashi } = Astro.props;
// 資料の名前の中のかぎかっこは、外のかぎかっこと重ならないよう二重かぎかっこにする
const quoted = (title: string) => title.replace(/「/g, "『").replace(/」/g, "』");
---
<section class="sheet aramashi">
  <h2>{name}のあらまし</h2>
  <p>{aramashi.text.join("")}</p>
  <p class="source muted">出典：{aramashi.sources.map((s, i) => (
    <>{i > 0 && "、"}<a href={s.url} target="_blank" rel="noopener">{s.publisher}「{quoted(s.title)}」</a></>
  ))}（{checkedLabel(aramashi.checked)}に確認）。資料で確かめた事実を、データさんぽが短くまとめたものです。</p>
</section>

<style>
  .aramashi > p:first-of-type { line-height: 1.9; }
  .aramashi .source { font-size: 0.86rem; line-height: 1.7; }
</style>
