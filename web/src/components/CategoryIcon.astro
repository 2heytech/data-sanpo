---
// 指標のカテゴリのピクトグラム（24×24、線画。色はサイトのアクセント色）
interface Props { category: string }
const { category } = Astro.props;
const PATHS: Record<string, string> = {
  // 2人
  "人口・世帯": '<circle cx="8" cy="7" r="3"/><path d="M2.5 20v-1.5a5.5 5.5 0 0 1 11 0V20"/><circle cx="17" cy="8.5" r="2.5"/><path d="M15 13.6a4.5 4.5 0 0 1 6.5 4V20"/>',
  // 年齢の帯（人口ピラミッド）
  "年齢構成": '<path d="M9 5h6M7 9.5h10M5 14h14M3 18.5h18"/>',
  // 家
  "暮らし方": '<path d="M3 11 12 4l9 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5h4v5"/>',
  // 地球
  "外国人住民": '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/>',
  // かばん
  "働き方": '<rect x="3" y="7.5" width="18" height="12" rx="2"/><path d="M9 7.5V5.5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 5.5v2M3 13h18"/>',
  // 行き来の矢印
  "通勤・通学": '<path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"/>',
  // 角帽
  "学歴": '<path d="M2 9.5 12 5l10 4.5-10 4.5z"/><path d="M6.5 11.5V16c0 1.5 2.5 3 5.5 3s5.5-1.5 5.5-3v-4.5M22 9.5V15"/>',
  // 本
  "教育": '<path d="M12 6.5C10 5 7 4.5 3 5v13c4-.5 7 0 9 1.5 2-1.5 5-2 9-1.5V5c-4-.5-7 0-9 1.5z"/><path d="M12 6.5v13"/>',
  // 盾
  "犯罪": '<path d="M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>',
  // 注意の三角
  "交通事故": '<path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5M12 17.2v.3"/>',
  // 電車
  "交通": '<rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 10h14M8.5 14h.01M15.5 14h.01M8 17l-2.5 4M16 17l2.5 4"/>',
  // 大人と子ども（手をつなぐ）
  "子育て": '<circle cx="8" cy="5.5" r="2.5"/><path d="M4 21v-7a4 4 0 0 1 8 0v7"/><circle cx="17" cy="10" r="2"/><path d="M14 21v-4a3 3 0 0 1 6 0v4M12 15h2"/>',
  // 木
  "緑": '<path d="M12 21v-6"/><path d="M12 15c-4 0-6.5-2.5-6.5-5.5S8 4 12 3c4 1 6.5 3.5 6.5 6.5S16 15 12 15z"/><path d="M9 21h6"/>',
  // 積んだ硬貨
  "所得・税": '<ellipse cx="12" cy="6" rx="7" ry="2.5"/><path d="M5 6v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6M5 10v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-4M5 14v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-4"/>',
  // 投票箱
  "選挙": '<path d="M4 11h16v9H4z"/><path d="M9 14h6"/><path d="M8 11V4.5h8V11"/><path d="M10.5 7.5 11.8 9l2.2-2.7"/>',
  // カメラ
  "観光": '<rect x="3" y="7" width="18" height="13" rx="2"/><circle cx="12" cy="13.5" r="3.5"/><path d="M8.5 7 10 4.5h4L15.5 7"/>',
  // 円の記号
  "地価": '<circle cx="12" cy="12" r="9"/><path d="M8.5 7 12 12l3.5-5M12 12v5.5M9 12.5h6M9 15h6"/>',
};
const path = PATHS[category] ?? '<circle cx="12" cy="12" r="8"/>';
---
<span class="category-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"
       stroke-linecap="round" stroke-linejoin="round" set:html={path} />
</span>

<style>
  .category-icon {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 36px; height: 36px; border-radius: 50%; background: #e8f0fa; color: var(--accent);
  }
</style>
