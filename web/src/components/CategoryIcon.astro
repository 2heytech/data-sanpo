const path = PATHS[category] ?? '<circle cx="12" cy="12" r="8"/>';
---
<span class="category-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"
       stroke-linecap="round" stroke-linejoin="round" set:html={path} />
</span>

<style>
  .category-icon {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 36px; height: 36px; border-radius: 50%; background: #e8f0fa; color: var(--accent);
  }
</style>
