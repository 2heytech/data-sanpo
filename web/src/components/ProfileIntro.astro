---
// 「データで見る〇〇」の中身。特徴を一言で表す題名、概要の文、テーマごとの「データから考えられること」。
// 考察に添える文（物差し・移り変わり・数え方の癖）は、考察の下に少し小さく出す（設計変更記録 #163）。
// 地域ページと都道府県ページで使う（設計変更記録 #113・#116・#140）。
// 資料で確かめた紹介の文（あらまし）があれば、題名の下・データの概要の前に出す（設計変更記録 #166）
import type { AreaProfile } from "../lib/areaInsights";
import type { Aramashi as AramashiData } from "../lib/aramashi";
import Aramashi from "./Aramashi.astro";

interface Props { name: string; profile: AreaProfile; summary: string[]; aramashi?: AramashiData | null }
const { name, profile, summary, aramashi } = Astro.props;
---
<h2>データで見る{name}</h2>
{profile.title && <p class="catch">{profile.title}</p>}
{aramashi && <Aramashi aramashi={aramashi} />}
{summary.map((line) => <p>{line}</p>)}
{profile.lines.length > 0 && (
  <>
    <h3>データから考えられること</h3>
    <div class="insight-groups">
      {profile.groups.map((g) => (
        <section class="insight-group">
          <h4>{g.theme}</h4>
          <ul class="insights">{g.lines.map((line, i) => <li>{line}{g.more[i] && <span class="more">{g.more[i]}</span>}</li>)}</ul>
        </section>
      ))}
    </div>
  </>
)}
<p class="muted">順位は値の大きい順で、大きいほど良い・悪いという意味ではありません。
  {profile.lines.length > 0 && "「考えられること」はデータの組み合わせから推測したもので、実際の理由を確かめたものではありません。"}</p>

<style>
  h2:first-child { margin-top: 0; }
  .catch {
    margin: 0.2em 0 0.9em; padding: 10px 14px; border-radius: 10px; background: var(--accent-soft);
    color: var(--accent-ink); font-size: 1.12rem; font-weight: 700; line-height: 1.5;
  }
  .insight-groups { display: grid; gap: 14px; margin-top: 4px; }
  .insight-group { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: 4px 14px; align-items: start; }
  .insight-group h4 {
    margin: 2px 0 0; padding: 2px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-ink);
    font-size: 0.8rem; font-weight: 700; text-align: center; white-space: nowrap;
  }
  .insights { margin: 0; padding-left: 1.2em; }
  .insights li + li { margin-top: 0.5em; }
  .insights .more { display: block; margin-top: 0.25em; color: var(--muted); font-size: 0.92em; }
  @media (max-width: 640px) {
    .insight-group { grid-template-columns: 1fr; }
    .insight-group h4 { justify-self: start; }
  }
</style>
