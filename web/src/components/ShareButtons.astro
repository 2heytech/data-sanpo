---
// ページのリンクをコピーするボタン（#153・#156）。SNS などへ送るボタンは置かない。
interface Props {
  /** ページの題名（ボタンの説明に使う） */
  title: string;
}
const { title } = Astro.props;
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
---
<section class="share-row" aria-label="このページのリンク">
  <button type="button" class="share-chip" data-share-copy={url} title={`「${title}」のリンクをコピー`}>このページのリンクをコピー</button>
</section>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-share-copy]")) {
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.shareCopy!);
        b.textContent = "コピーしました";
      } catch {
        window.prompt("このページのリンク", b.dataset.shareCopy!);
      }
    });
  }
</script>

<style>
  .share-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 24px 0; }
  .share-chip {
    display: inline-flex; align-items: center; padding: 6px 14px; border: 1px solid var(--line-strong); border-radius: 999px;
    background: var(--surface); color: var(--accent-ink); font: inherit; font-size: 0.85rem; font-weight: 600; line-height: 1.4;
    cursor: pointer;
  }
  .share-chip:hover { background: var(--accent-soft); }
</style>
