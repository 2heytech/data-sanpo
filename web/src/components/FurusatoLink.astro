---
// 地域ページの「ふるさと納税の返礼品」の欄（楽天ふるさと納税へのリンク、設計変更記録 #189）。
// 政令指定都市の区は区ごとの寄附先がないので、市の返礼品を探すリンクにする。ID がなければ何も出さない。
// 楽天の API のキーがあれば、欄が画面に入ったときに返礼品を4件まで画像付きで並べる（#195。components/FurusatoItems.astro）。
// 取れなかったとき・その自治体の品が見つからないときは何も足さず、リンクのボタンだけにする。
// 欄は「主な指標」の前に置いて目次から移れるようにし、最初の1文はその市区町村の受入額（上位なら順位も）にする。
// ボタンは藍の塗り、「広告」は見出しの横に1つ（#252）
import { rakutenAffiliateUrl, rakutenFurusatoSearchUrl } from "../lib/rakuten";
import FurusatoItems from "./FurusatoItems.astro";
import { isDesignatedWard } from "../lib/prefecturePage";
import type { Municipality } from "../lib/types";

interface Props { muni: Municipality; pref: string; lead?: string | null }
const { muni, pref, lead } = Astro.props;
const ward = isDesignatedWard(muni);
const target = ward ? muni.region! : muni.name;
const href = pref ? rakutenAffiliateUrl(rakutenFurusatoSearchUrl(pref, target)) : null;
---
{href && (
  <section class="sheet furusato-link furusato-box" id="furusato">
    <h2>ふるさと納税の返礼品<span class="ad-mark">広告</span></h2>
    <p>
      {lead ? `${lead}返礼品は楽天ふるさと納税で探せます。` : `${ward ? `${muni.name}を含む${target}` : target}へのふるさと納税の返礼品は、楽天ふるさと納税で探せます。`}
    </p>
    <FurusatoItems pref={pref} name={target} />
    <p class="furusato-cta">
      <a class="button ext-link" href={href} target="_blank" rel="sponsored noopener"><span>楽天ふるさと納税で<span class="wide-only">{target}の</span>返礼品を見る</span></a>
    </p>
  </section>
)}

