---
import Article from "../layouts/Article.astro";
import ArticleLink from "../components/ArticleLink.astro";
import ArticleRanking from "../components/ArticleRanking.astro";
import { check, nationalRaw, nationalValue, rankNumber, ranking, raw, value } from "../lib/articleData";

const PADDY = "land_use_paddy_share";
const PP = "2021-04-01";
const BAMBOO = "vegetation_bamboo_share";
const BP = "2024-04-01";
const MOSEUSHI = "muni-01433";
const OGATA = "muni-05368";
const SUO_OSHIMA = "muni-35305";
const ASAHI = "muni-24343";
// 題名の「8割近くが田んぼの町」: 1位が妹背牛町で、75〜80%。「2位の美里町、同じく2位の大潟村」
const top3 = ranking(PADDY, PP, "municipality", "high", 3, [MOSEUSHI, "muni-04505", OGATA]);
const moseushi = raw(PADDY, PP, MOSEUSHI);
if (moseushi !== null) {
  check(top3[0]?.entity_id === MOSEUSHI && moseushi >= 75 && moseushi < 80, "妹背牛町の田の割合が、1位で8割近くではありません");
  check(top3.filter((r) => r.entity_id === "muni-04505" || r.entity_id === OGATA).every((r) => r.rank === 2), "美里町・大潟村が2位ではありません");
  // 「全国のおよそ10倍」
  const times = moseushi / (nationalRaw(PADDY, PP) ?? NaN);
  check(times >= 9.5 && times < 10.5, "妹背牛町の田の割合が全国のおよそ10倍ではありません");
  // 「竹林の1位は周防大島町、2位は朝日町」「朝日町は三重県でいちばん面積の小さい町」
  check(rankNumber(BAMBOO, BP, SUO_OSHIMA) === 1 && rankNumber(BAMBOO, BP, ASAHI) === 2, "竹林の割合の1位・2位が周防大島町・朝日町ではありません");
  check(ranking("area", "2025-10-01", "municipality", "low", 400).filter((r) => r.entity_id.startsWith("muni-24"))[0]?.entity_id === ASAHI,
    "朝日町が三重県でいちばん面積の小さい市町ではありません");
  // 「竹林の割合が高い都道府県は、上位5つがすべて中国・九州」
  check(ranking(BAMBOO, BP, "prefecture", "high", 5).every((r) => ["pref-35", "pref-40", "pref-41", "pref-43", "pref-46"].includes(r.entity_id)),
    "竹林の割合の高い都道府県の上位5つが本文と合いません");
}
---
<Article slug="paddy-bamboo">
  <p>
    町の陸地の8割近くが田んぼ。そんな町が北海道にあります。石狩川沿いの妹背牛町で、田の割合は{value(PADDY, PP, MOSEUSHI)}です。
    全国では{nationalValue(PADDY, PP)}なので、およそ10倍にあたります（2021年度）。
  </p>
  <p>
    まちの土地がどう使われているかは、国土交通省の土地利用のデータ（100m四方のマスごとの土地利用）から分かります。
    田んぼの多いまちを見たあとで、環境省の植生図から、竹林の多いまちも見ていきます。
  </p>
  <ArticleRanking id={PADDY} period={PP} n={10}
    expect={[MOSEUSHI, "muni-04505", OGATA, "muni-07422", "muni-06426", "muni-41425", "muni-01434", "muni-02367"]}
    caption="田の割合が高い市区町村（2021年度）" />

  <h2>田んぼの多いまちは、平野と盆地にある</h2>
  <p>
    妹背牛町は、石狩川の流域に広がる空知地方の米どころです。同じ空知地方の秩父別町も上位に入ります。
  </p>
  <p>
    2位の宮城県美里町は大崎平野、同じく2位の秋田県大潟村は八郎潟を干拓した土地、福島県湯川村は会津盆地、山形県三川町は庄内平野、
    佐賀県白石町は佐賀平野、青森県田舎館村は津軽平野にあります。上位10は、どれも各地の平野や盆地の米どころです。
    <ArticleLink slug="elevation">大潟村の平均標高が海面より低いこと</ArticleLink>
  </p>
  <p>
    都道府県で最も高いのは佐賀県（{value(PADDY, PP, "pref-41")}）で、千葉県、茨城県、宮城県の順です。
    こちらも佐賀平野、関東平野、仙台平野と、広い平野のある県です。
    全国の田の割合は、1976年度の{nationalValue(PADDY, "1976-04-01")}から2021年度は{nationalValue(PADDY, PP)}になりました。
  </p>
  <ArticleRanking id={PADDY} period={PP} level="prefecture" n={5} expect={["pref-41", "pref-12", "pref-08", "pref-04"]} caption="田の割合が高い都道府県（2021年度）" />

  <h2>竹林の多いまちは、西日本にある</h2>
  <p>
    田んぼが各地の平野や盆地に多いのに対して、竹林は西日本に多い植生です。
    竹林の割合が高い都道府県は山口県（{value(BAMBOO, BP, "pref-35")}）と福岡県（{value(BAMBOO, BP, "pref-40")}）で、
    佐賀県、熊本県、鹿児島県と、上位5つを中国・九州の県が占めます。
  </p>
  <ArticleRanking id={BAMBOO} period={BP} level="prefecture" n={5} expect={["pref-35", "pref-40"]} caption="竹林の割合が高い都道府県" />
  <p>
    市区町村で最も高いのは山口県周防大島町（{value(BAMBOO, BP, SUO_OSHIMA)}）です。田布施町・平生町・柳井市と、
    瀬戸内海に面した山口県の東部のまちが上位に多く入ります。
    2位の三重県朝日町（{value(BAMBOO, BP, ASAHI)}）は、三重県でいちばん面積の小さい町です。
  </p>
  <p>
    京都府の長岡京市・大山崎町は、昔からタケノコの産地として知られる地域です。竹林は手入れをしながら使われてきた一方、
    竹は育つのが早く、人の手が入らなくなった山林や畑にも広がりやすいため、竹林の割合が高くなっている所もあると考えられます。
  </p>
  <ArticleRanking id={BAMBOO} period={BP} n={10}
    expect={[SUO_OSHIMA, ASAHI, "muni-35343", "muni-35344", "muni-35212", "muni-26209", "muni-26303"]}
    caption="竹林の割合が高い市区町村" />

  <h2>土地の使われ方に、まちの姿が表れる</h2>
  <p>
    8割近くが田んぼの町は、北海道の妹背牛町でした。田んぼは平野や盆地のまちに、竹林は瀬戸内海沿いや京都のまちに多く、
    土地の使われ方には、その土地の地形や、人が土地とどうかかわってきたかが表れます。
    地図の背景を「土地利用」に切り替えると、田んぼや森林、建物の広がりそのものも見られます。
    自分のまちの土地がどう使われているか、確かめてみてください。
  </p>
  <p><a class="button" href={`/map/?i=${PADDY}&p=${PP}&l=municipality`}>田の割合を地図で見る</a></p>

  <h2>読むときの注意</h2>
  <ul>
    <li>土地利用は、100m四方のマスごとに最も広い使い方でマス全体を数えた値です。マスより小さな田や畑は数に入らないことがあります。</li>
    <li>年度によって土地利用の判読の方法が違うため、1976年度と2021年度の差には、判読の違いも含まれます。</li>
    <li>植生図の調査の年は地域によって違います（2000〜2023年度）。竹林の割合の分母は、水面・市街地・農地も含む、植生図のある範囲の面積です。</li>
  </ul>
</Article>
