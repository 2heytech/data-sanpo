---
import Article from "../layouts/Article.astro";
import ArticleRanking from "../components/ArticleRanking.astro";
import { check, ranking, raw, rows, value } from "../lib/articleData";

const ID = "slope_building_mean";
const STEEP = "slope_building_steep_share";
const ALL = "slope_mean";
const P = "2021-04-01";
const PA = "2026-10-01";
const POP = "population_total";
const PP = "2025-10-01";
const OKAWA = "muni-39364";
const TOTSUKAWA = "muni-29449";
const OKUTAMA = "muni-13308";
const ATAMI = "muni-22205";
const SHIMODA = "muni-22219";
const ITO = "muni-22208";
const IZU = "muni-22222";
const TSUSHIMA = "muni-42209";
const NAGASAKI = "muni-42201";
const SASEBO = "muni-42202";
const YOKOSUKA = "muni-14201";
const HODOGAYA = "muni-14106";
const TARUMI = "muni-28108";
const HAYAKAWA = "muni-19364";

const ids = (list: { entity_id: string }[]) => list.map((r) => r.entity_id).join();

// 題名「坂の多いまち」: 市区町村の1〜3位が大川村・十津川村・奥多摩町
check(ids(ranking(ID, P, "municipality", "high", 3)) === [OKAWA, TOTSUKAWA, OKUTAMA].join(), "建物用地の平均傾斜の1〜3位が大川村・十津川村・奥多摩町ではありません");
// 大川村の建物用地のうち、急な斜面（15度以上）は4分の3近く
const okawaSteep = raw(STEEP, P, OKAWA) ?? NaN;
check(okawaSteep >= 70 && okawaSteep < 75, "大川村の急な斜面の割合が4分の3近く（70〜75%）ではありません");

// 市の1位は熱海市で、急な斜面の割合も市で1位。下田市が2位。伊東市・伊豆市も市の上位15に入る
check(ids(ranking(ID, P, "municipality", "high", 2, [], { kind: "市" })) === [ATAMI, SHIMODA].join(), "市の1・2位が熱海市・下田市ではありません");
check(ranking(STEEP, P, "municipality", "high", 1, [], { kind: "市" })[0]?.entity_id === ATAMI, "急な斜面の割合の市の1位が熱海市ではありません");
check(ranking(ID, P, "municipality", "high", 15, [ITO, IZU], { kind: "市" }).length === 15, "伊東市・伊豆市が市の上位15に入っていません");
// 市の上位10のうち長崎県の市は4つ
const nagasakiCities = ranking(ID, P, "municipality", "high", 10, [], { kind: "市" }).filter((r) => r.entity_id.startsWith("muni-42")).length;
check(nagasakiCities === 4, "市の上位10に長崎県の市が4つ入っていません");

// 人口20万人以上（2025年国勢調査、政令指定都市は区ごと）では長崎市・佐世保市・横須賀市・保土ケ谷区・垂水区の順
const big = new Set(rows(POP, PP, "municipality").filter((r) => (r.value ?? 0) >= 200000).map((r) => r.entity_id));
const bigTop = rows(ID, P, "municipality").filter((r) => r.value !== null && big.has(r.entity_id))
  .sort((a, b) => (b.value as number) - (a.value as number)).slice(0, 5);
check(ids(bigTop) === [NAGASAKI, SASEBO, YOKOSUKA, HODOGAYA, TARUMI].join(), "人口20万人以上の1〜5位が長崎市・佐世保市・横須賀市・保土ケ谷区・垂水区ではありません");
// 長崎市の資料の「15度以上の所まで市街地」と並べる、長崎市の急な斜面の割合（2割あまり）
const nagasakiSteep = raw(STEEP, P, NAGASAKI) ?? NaN;
check(nagasakiSteep >= 20 && nagasakiSteep < 30, "長崎市の急な斜面の割合が2割あまりではありません");

// 都道府県: 長崎県・高知県・広島県の順。急な斜面の割合も長崎県が1位。最も小さいのは埼玉県
check(ids(ranking(ID, P, "prefecture", "high", 3)) === ["pref-42", "pref-39", "pref-34"].join(), "都道府県の1〜3位が長崎県・高知県・広島県ではありません");
check(ranking(STEEP, P, "prefecture", "high", 1)[0]?.entity_id === "pref-42", "急な斜面の割合の都道府県の1位が長崎県ではありません");
check(ranking(ID, P, "prefecture", "low", 1)[0]?.entity_id === "pref-11", "建物用地の平均傾斜が最も小さい都道府県が埼玉県ではありません");

// 地面全体の平均傾斜は、大川村・熱海市・長崎市とも建物用地より大きい。地面全体の1位は早川町
check([OKAWA, ATAMI, NAGASAKI].every((e) => (raw(ALL, PA, e) ?? 0) > (raw(ID, P, e) ?? Infinity)), "地面全体の平均傾斜が建物用地より大きくない市町村があります");
check(ranking(ALL, PA, "municipality", "high", 1)[0]?.entity_id === HAYAKAWA, "平均傾斜（地面全体）の1位が早川町ではありません");
---
<Article slug="slope-building">
  <p>
    坂の多いまちはどこでしょうか。家や店、工場などが建っている土地（建物用地）の地面の傾きの平均を、市区町村ごとに比べてみます。
    国土交通省の土地利用のデータ（2021年度、100m四方のマスごと）と、国土地理院の標高のデータ（約10m間隔）から、このサイトで計算した値です。
    山や森の斜面は数えず、人が住んだり働いたりしている土地の傾きだけを見るので、坂の上に家が並ぶまちほど値が大きくなります。
  </p>

  <h2>1位は高知県大川村</h2>
  <p>
    1位は高知県大川村の{value(ID, P, OKAWA)}で、奈良県十津川村（{value(ID, P, TOTSUKAWA)}）、東京都奥多摩町（{value(ID, P, OKUTAMA)}）が続きます。上位10は、どれも山あいの町村です。
  </p>
  <p>
    大川村は高知県の最北端にあり、1,000m以上の山に囲まれた村です。集落は村の中央を流れる吉野川の両岸に点在し、
    高知県と大川村の資料では「平地のほとんどない」村と紹介されています。
    建物用地のうち、傾きが15度以上の急な斜面にある土地の割合は{value(STEEP, P, OKAWA)}で、4分の3近くになります。
  </p>
  <ArticleRanking id={ID} period={P} n={10} expect={[OKAWA, TOTSUKAWA, OKUTAMA]} caption="建物用地の平均傾斜が大きい市区町村（2021年度）" />

  <h2>市の1位は熱海市</h2>
  <p>
    市だけで比べると、1位は静岡県熱海市の{value(ID, P, ATAMI)}で、2位の下田市（{value(ID, P, SHIMODA)}）を大きく上回ります。
    建物用地のうち急な斜面にある割合も{value(STEEP, P, ATAMI)}で、市の中で最も高くなっています。
  </p>
  <p>
    熱海市は、火山がつくった急な斜面が相模灘に面したまちです。静岡県の地形の資料では、山腹の傾斜地にも市街地が広がったと説明されています。
    2位の下田市のほか、伊東市（{value(ID, P, ITO)}）や伊豆市（{value(ID, P, IZU)}）も市の上位15に入り、伊豆半島の市が多く並びます。
  </p>
  <ArticleRanking id={ID} period={P} kind="市" n={10} expect={[ATAMI, SHIMODA, TSUSHIMA, NAGASAKI]} caption="建物用地の平均傾斜が大きい市（2021年度）" />

  <h2>大きな市では長崎市</h2>
  <p>
    人口20万人以上の市区町村（2025年国勢調査、政令指定都市は区ごと）に限ると、1位は長崎市（{value(ID, P, NAGASAKI)}）で、
    長崎県佐世保市（{value(ID, P, SASEBO)}）、神奈川県横須賀市（{value(ID, P, YOKOSUKA)}）、横浜市保土ケ谷区（{value(ID, P, HODOGAYA)}）、神戸市垂水区（{value(ID, P, TARUMI)}）が続きます。
  </p>
  <p>
    長崎市のページ「『さかんまち』長崎のなりたち」によると、長崎の市街地は、港に注ぐ2本の川沿いのわずかな平地と、そこから続く斜面にできています。
    住宅を建てるには費用がかかりすぎるといわれる15度以上の所にまで、まちが広がっているとも書かれています。
    このサイトの「急な斜面」も15度以上で、長崎市の建物用地のうち急な斜面にある土地は{value(STEEP, P, NAGASAKI)}です。
  </p>
  <p class="map-links">
    <a class="button" href={`/map/?i=${ID}&p=${P}&a=${NAGASAKI}&l=small_area`}>長崎市の町丁目を地図で見る</a>
    <a class="button secondary" href={`/map/?i=${ID}&p=${P}&a=${ATAMI}&l=small_area`}>熱海市の町丁目を地図で見る</a>
  </p>

  <h2>都道府県では長崎県</h2>
  <p>
    都道府県で比べると、1位は長崎県の{value(ID, P, "pref-42")}で、高知県（{value(ID, P, "pref-39")}）、広島県（{value(ID, P, "pref-34")}）が続きます。
    急な斜面にある割合も長崎県（{value(STEEP, P, "pref-42")}）が1位で、市の上位10にも長崎県の市が長崎市・対馬市・西海市・平戸市の4つ入っています。
    反対に、最もなだらかなのは埼玉県（{value(ID, P, "pref-11")}）です。
  </p>
  <ArticleRanking id={ID} period={P} level="prefecture" n={10} expect={["pref-42", "pref-39", "pref-34"]} caption="建物用地の平均傾斜が大きい都道府県（2021年度）" />

  <h2>家が建つ所は、まわりよりなだらか</h2>
  <p>
    建物用地に限らない、地面全体の平均傾斜も比べてみます。大川村は{value(ALL, PA, OKAWA)}、熱海市は{value(ALL, PA, ATAMI)}、長崎市は{value(ALL, PA, NAGASAKI)}で、
    どれも建物用地の値より大きくなります。坂のまちでも、家や店は、まちの中では比べてなだらかな所に建っていることが分かります。
    地面全体の平均傾斜の1位は、山梨県早川町（{value(ALL, PA, HAYAKAWA)}）です。
  </p>
  <p class="map-links">
    <a class="button" href={`/map/?i=${ALL}&p=${PA}&a=${OKAWA}&l=municipality`}>地面全体の平均傾斜を地図で見る</a>
  </p>

  <h2>読むときの注意</h2>
  <ul>
    <li>100m四方のマスごとに、その中で最も広い土地利用でマス全体を建物用地としています。マスの中の斜面林や崖なども含むため、実際の宅地より傾きが大きく出ることがあります。</li>
    <li>標高は主に地形図の等高線から作られていて、ひな壇の造成地や石垣など、約10mより短い段差はなだらかになります。</li>
    <li>土地利用は2021年度、標高は2026年10月時点の国土地理院のデータです。</li>
    <li>地面の傾きを表す値で、土砂災害の起こりやすさを表すものではありません。</li>
  </ul>
</Article>

<style>
  .map-links { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
