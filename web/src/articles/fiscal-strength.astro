---
import Article from "../layouts/Article.astro";
import ArticleLink from "../components/ArticleLink.astro";
import ArticleRanking from "../components/ArticleRanking.astro";
import { check, count, man, rankNumber, ranking, raw, rows, value } from "../lib/articleData";
import { formatNumber } from "../lib/format";

const P = "2024-04-01";
const ID = "fiscal_strength_index";
const TOBISHIMA = "muni-23427";
const KARUIZAWA = "muni-20321";
const atLeast1 = (v: number) => v >= 1;
// 題名の「財政力指数1位は○○村？」: 1位が愛知県飛島村で、2に近い（1.9以上2.0未満）
ranking(ID, P, "municipality", "high", 1, [TOBISHIMA]);
check((raw(ID, P, TOBISHIMA) ?? 0) >= 1.9 && (raw(ID, P, TOBISHIMA) ?? 0) < 2, "飛島村の財政力指数が「ほぼ2」ではありません");
// 飛島村の人口（2025年国勢調査）と、昼の人口が住民の何倍か（2020年国勢調査の昼夜間人口比率 ÷ 100）
const tobishimaPop = raw("population_total", "2025-10-01", TOBISHIMA);
const tobishimaDay = formatNumber((raw("daytime_night_ratio", "2020-10-01", TOBISHIMA) ?? 0) / 100, 1);
check((tobishimaPop ?? 0) >= 4000 && (tobishimaPop ?? 0) < 5000, "飛島村の人口が4千人台ではありません");
// 本文の「武蔵野市・浦安市・芦屋市は納税者1人あたりの課税対象所得も全国の上位」を確かめる
ranking("taxable_income_per_taxpayer", "2025-04-01", "municipality", "high", 30, ["muni-13203", "muni-12227", "muni-28206"]);
// 「2020年度から2022年度に減り、2024年度はまた増えた」を確かめる
const n = (period: string) => Number(count(ID, period, "municipality", atLeast1).replace(/,/g, ""));
if (!Number.isNaN(n(P))) check(n("2020-04-01") > n("2022-04-01") && n(P) > n("2022-04-01"), "財政力指数が1以上の数の増減が本文と違います");
// 「1以上の市町村は愛知県が最も多く、次が東京都、その次が千葉県」
const byPref = new Map<string, number>();
for (const r of rows(ID, P, "municipality")) if (r.value !== null && r.value >= 1) byPref.set(r.entity_id.slice(5, 7), (byPref.get(r.entity_id.slice(5, 7)) ?? 0) + 1);
const prefOrder = [...byPref].sort((a, b) => b[1] - a[1]);
if (prefOrder.length) check(prefOrder.slice(0, 3).map((x) => x[0]).join() === "23,13,12" && prefOrder[2][1] > (prefOrder[3]?.[1] ?? 0) && prefOrder[0][1] > prefOrder[1][1] && prefOrder[1][1] > prefOrder[2][1],
  "財政力指数が1以上の市町村の多い都道府県が、愛知県・東京都・千葉県の順ではありません");
// 「1以上は20に1つもない」
const total = Number(count(ID, P, "municipality").replace(/,/g, ""));
if (!Number.isNaN(n(P))) check(n(P) / total < 0.05, "財政力指数が1以上の市町村が、全体の5%以上あります");
// 「軽井沢町は4位」
const karuizawaRank = rankNumber(ID, P, KARUIZAWA);
---
<Article slug="fiscal-strength">
  <p>
    財政力指数の全国1位は、愛知県飛島村の{value(ID, P, TOBISHIMA)}です。
    標準的な行政サービスに必要な費用の、ほぼ2倍の収入がある計算になります。
  </p>
  <p>
    飛島村は人口{man(tobishimaPop)}人の村です（2025年国勢調査）。名古屋港に面していて、臨海部の工場や物流の施設に、村の外から多くの人が働きに来ます。
    昼の人口は住民の{tobishimaDay}倍になります（2020年国勢調査）。住む人に比べて事業所が多く、企業からの税収が村の財政を支えていると考えられます。
    <ArticleLink slug="daytime-population">昼の人口が住民の何倍にもなるまち</ArticleLink>
  </p>
  <div class="note">
    <strong>財政力指数の読み方</strong>
    <ul>
      <li>標準的な行政サービスに必要な費用を、税収など自前の収入でどれだけまかなえるかを表す目安です。</li>
      <li>基準財政収入額 ÷ 基準財政需要額 の、直近3年度の平均です（2024年度の値は2022〜2024年度の平均）。</li>
      <li>1以上なら自前の収入で費用をまかなえる水準とされ、国から普通交付税を受け取らないことが多くなります。</li>
      <li>1未満の市町村は、足りない分を普通交付税で補う仕組みです。全国のほとんどの市町村がこちらで、1未満であることが財政の良し悪しをすぐに表すわけではありません。</li>
    </ul>
  </div>
  <ArticleRanking id={ID} period={P} n={15}
    expect={[TOBISHIMA, "muni-02411", "muni-18481", KARUIZAWA, "muni-13203", "muni-12227", "muni-15504", "muni-41387", "muni-23211", "muni-01403", "muni-23236", "muni-08341", "muni-08232"]}
    caption="財政力指数が高い市町村（2024年度）" />

  <h2>1以上は、20に1つもない</h2>
  <p>
    2024年度に財政力指数が1以上だったのは、値のある{count(ID, P, "municipality")}市区町村のうち{count(ID, P, "municipality", atLeast1)}です。
    2020年度の{count(ID, "2020-04-01", "municipality", atLeast1)}から2022年度は{count(ID, "2022-04-01", "municipality", atLeast1)}に減り、
    2024年度はまた増えました。
  </p>
  <p>
    都道府県別では愛知県が{count(ID, P, "municipality", atLeast1, "23")}と最も多く、次が東京都の{count(ID, P, "municipality", atLeast1, "13")}、
    その次が千葉県の{count(ID, P, "municipality", atLeast1, "12")}です。
  </p>

  <h2>上位に入るまちの、4つの型</h2>
  <p>
    総務省の「地方公共団体の主要財政指標一覧」から、財政力指数が1以上の市町村を見ると、いくつかの型があるようです。
    どれも、住む人の数に比べて、税収のもとになる施設や所得が大きいまちです。
  </p>
  <h3>工場の多いまち</h3>
  <p>
    1位の飛島村のほか、自動車産業の集まる愛知県豊田市・みよし市・刈谷市・安城市、
    臨海部に工場が並ぶ茨城県神栖市・千葉県市原市・三重県四日市市、自動車工場のある福岡県苅田町なども1以上です。
  </p>
  <h3>発電所などの大きな施設があるまち</h3>
  <p>
    青森県六ヶ所村、福井県高浜町、新潟県刈羽村、佐賀県玄海町、北海道泊村、茨城県東海村など、原子力発電所や関連施設のある町村も上位に入ります。
    大きな施設の固定資産税の収入が多く、人口に比べて税収が多くなっていると考えられます。
  </p>
  <h3>空港のあるまち</h3>
  <p>
    成田空港のある千葉県成田市・芝山町、関西空港のある大阪府田尻町、名古屋空港のある愛知県豊山町も1以上です。
    空港の施設や、周りの企業からの税収によるものと思われます。
  </p>
  <h3>住宅地・別荘地のまち</h3>
  <p>
    東京都武蔵野市、千葉県浦安市、兵庫県芦屋市など、納税者1人あたりの課税対象所得も全国の上位にある住宅地のまちや、
    {karuizawaRank}位の長野県軽井沢町、神奈川県箱根町、山梨県山中湖村など、別荘や観光の施設が多いまちもあります。
    住民税や、別荘・ホテルなどの固定資産税の収入が多いためと考えられます。
    <ArticleLink slug="vacant-houses">別荘の多い軽井沢町の空き家率が70%になること</ArticleLink>
  </p>
  <details class="ranking-more">
    <summary>財政力指数が1以上の市町村をすべて見る（2024年度）</summary>
    <ArticleRanking id={ID} period={P} n={200} atLeast={1}
      expect={["muni-23210", "muni-23212", "muni-12219", "muni-24202", "muni-40621", "muni-12211", "muni-12409", "muni-27362", "muni-23342", "muni-28206", "muni-14382", "muni-19425"]}
      caption="財政力指数が1以上の市町村（2024年度）" />
  </details>

  <h2>財政力指数は、住む人の数とは別に決まる</h2>
  <p>
    財政力指数の1位は、人口4千人あまりの飛島村でした。上位には、工場や発電所、空港、別荘など、
    住む人の数に比べて大きな施設のあるまちが多く入ります。大きな市であれば高くなる、という数字ではありません。
    反対に、1未満のまちが全国のほとんどを占めていて、1未満であることが財政の良し悪しをすぐに表すわけでもありません。
    自分のまちの値と、まわりのまちの値を、地図で見比べてみてください。
  </p>
  <p><a class="button" href={`/map/?i=${ID}&p=${P}&l=municipality`}>財政力指数を地図で見る</a></p>

  <h2>読むときの注意</h2>
  <ul>
    <li>政令指定都市は市全体の値しか公表されていないため、区の値はありません（値のある市区町村は{count(ID, P, "municipality")}です）。</li>
    <li>東京都の特別区（23区）は、都と区の財政調整の仕組みの対象で、普通交付税の仕組みとは違います。</li>
    <li>財政力指数は、行政サービスの費用を自前の収入でまかなえる度合いの目安で、地方債の残高や、住民サービスの充実度を表すものではありません。</li>
  </ul>
</Article>
